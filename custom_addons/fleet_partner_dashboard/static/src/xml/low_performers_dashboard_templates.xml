<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlLowPerformersDashboard" owl="1">
    <div class="o_fleet_dashboard"
         style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;">
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">

        <h1 class="mb-4 d-flex align-items-center">
          <span>Low Performers</span>
          <i class="fa fa-info-circle text-muted"
             t-att-title="state.infoText"
             style="cursor: help; font-size: 0.9em; margin-left: 8px;"
             aria-label="Information"/>
        </h1>

        <!-- FILTER BAR (sticky layer 1) -->
        <div t-ref="filtersBar"
             class="mb-3 p-3 bg-light rounded d-flex align-items-center gap-2 flex-wrap sticky-filters">
          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.draftSelectedProducts.length">
                (<t t-esc="state.draftSelectedProducts.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showProducts}"
                 style="max-height:200px;overflow:auto">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Quality -->
          <div class="dropdown" t-att-class="{'show': state.showScores}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showScores')">
              Driver Quality
              <t t-if="state.draftSelectedScores.length">
                (<t t-esc="state.draftSelectedScores.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showScores}">
              <t t-foreach="[
                {key:'Low Performer',label:'Low Performer'},
                {key:'Average Performer',label:'Average Performer'},
                {key:'High Performer',label:'High Performer'}
              ]"
                 t-as="sc" t-key="sc.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedScores.includes(sc.key)}"
                        t-on-click="() => toggleFilter('selectedScores', sc.key)">
                  <t t-esc="sc.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown" t-att-class="{'show': state.showCategories}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showCategories')">
              Driver Category
              <t t-if="state.draftSelectedCategories.length">
                (<t t-esc="state.draftSelectedCategories.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showCategories}"
                 style="max-height:220px;overflow:auto">
              <t t-foreach="state.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Risk -->
          <div class="dropdown" t-att-class="{'show': state.showRisks}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showRisks')">
              Risk
              <t t-if="state.draftSelectedRisks.length">
                (<t t-esc="state.draftSelectedRisks.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showRisks}">
              <t t-foreach="state.risks" t-as="rk" t-key="rk.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedRisks.includes(rk.key)}"
                        t-on-click="() => toggleFilter('selectedRisks', rk.key)">
                  <t t-esc="rk.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Issues Reported -->
          <div class="dropdown" t-att-class="{'show': state.showIssues}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showIssues')">
              Issues Reported
              <t t-if="state.draftSelectedIssues.length">
                (<t t-esc="state.draftSelectedIssues.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showIssues}">
              <t t-foreach="[{key:'Yes',label:'Yes'},{key:'No',label:'No'}]"
                 t-as="opt" t-key="opt.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedIssues.includes(opt.key)}"
                        t-on-click="() => toggleFilter('selectedIssues', opt.key)">
                  <t t-esc="opt.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Period -->
          <div class="dropdown" t-att-class="{'show': state.showPeriod}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showPeriod')">
              <t t-esc="periodButtonLabel()"/>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showPeriod}">
              <t t-foreach="state.timePeriods" t-as="p" t-key="p">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedPeriod === p}"
                        t-on-click="() => changePeriod(p)">
                  <t t-esc="p"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Manual date range -->
          <div class="d-flex align-items-center gap-2 ms-auto">
            <input type="date"
                   class="form-control"
                   style="min-width: 180px"
                   t-att-value="state.draftStartDate"
                   t-on-change="onStartDateChange"/>
            <span>to</span>
            <input type="date"
                   class="form-control"
                   style="min-width: 180px"
                   t-att-value="state.draftEndDate"
                   t-on-change="onEndDateChange"/>
          </div>

          <!-- Apply Filters -->
          <button class="btn btn-primary"
                  t-att-disabled="!isDirty()"
                  t-on-click="applyFilters">
            Apply Filters
          </button>
        </div>

        <!-- SEARCH (sticky layer 2) -->
        <div t-ref="searchBar"
             class="mb-3 sticky-search">
          <input type="text"
                 class="form-control"
                 placeholder="Search name or phone…"
                 t-on-input="onSearchChange"/>
        </div>

        <!-- STICKY CLONE HEADER HOST (layer 3) -->
        <div t-ref="stickyHeader" class="fp-sticky-header fp-hidden"></div>

        <!-- TABLE (real header scrolls away) -->
        <div class="table-responsive" t-ref="tableWrap">
          <table class="table table-striped table-hover mb-0" t-ref="driversTable">
            <thead class="table-light lp-sticky-thead">
              <tr>
                <th data-sort-key="name"
                    style="cursor:pointer"
                    t-on-click="() => setSort('name')">
                  Name
                  <t t-if="state.sortKey === 'name'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="phone"
                    style="cursor:pointer"
                    t-on-click="() => setSort('phone')">
                  Phone No.
                  <t t-if="state.sortKey === 'phone'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="risk"
                    style="cursor:pointer"
                    t-on-click="() => setSort('risk')">
                  Risk
                  <t t-if="state.sortKey === 'risk'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="trips"
                    style="cursor:pointer"
                    t-on-click="() => setSort('trips')">
                  Trips
                  <t t-if="state.sortKey === 'trips'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="hours"
                    style="cursor:pointer"
                    t-on-click="() => setSort('hours')">
                  Hours Online
                  <t t-if="state.sortKey === 'hours'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="cash"
                    style="cursor:pointer"
                    t-on-click="() => setSort('cash')">
                  Gross Revenue (Kz)
                  <t t-if="state.sortKey === 'cash'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="acceptance_rate"
                    style="cursor:pointer"
                    t-on-click="() => setSort('acceptance_rate')">
                  Acceptance %
                  <t t-if="state.sortKey === 'acceptance_rate'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="completion_rate"
                    style="cursor:pointer"
                    t-on-click="() => setSort('completion_rate')">
                  Completion %
                  <t t-if="state.sortKey === 'completion_rate'">
                    <span class="ms-1"
                          t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th>Issues Reported</th>
              </tr>
            </thead>

            <tbody>
              <t t-foreach="pagedDrivers()" t-as="d" t-key="d.id">
                <tr>
                  <td>
                    <a href="#" t-on-click="() => openDriver(d)">
                      <t t-esc="d.name"/>
                    </a>
                  </td>
                  <td><t t-esc="d.phone"/></td>

                  <!-- RISK cell highlighting -->
                  <td
                    t-att-class="(d.risk === 'High' ? 'bg-danger text-dark fw-bold' : (d.risk === 'Medium' ? 'bg-warning text-dark fw-bold' : ''))"
                    t-att-style="d.risk === 'High'
                                  ? 'background-color:#f8d7da !important;'
                                  : (d.risk === 'Medium'
                                      ? 'background-color:#fff3cd !important;'
                                      : '')">
                    <t t-esc="d.risk"/>
                  </td>

                  <td><t t-esc="formatNumber(d.trips)"/></td>
                  <td><t t-esc="formatNumber(d.hours, 0)"/></td>
                  <td><t t-esc="formatNumber(d.cash, 0)"/></td>
                  <td><t t-esc="formatNumber(d.acceptance_rate, 1)"/>%</td>
                  <td><t t-esc="formatNumber(d.completion_rate, 1)"/>%</td>

                  <!-- ISSUES cell highlighting -->
                  <td
                    t-att-class="d.issues_reported === 'Yes' ? 'bg-danger text-dark fw-bold' : ''"
                    t-att-style="d.issues_reported === 'Yes'
                                  ? 'background-color:#f8d7da !important;'
                                  : ''"
                    t-att-aria-label="'Issues reported: ' + d.issues_reported">
                    <t t-esc="d.issues_reported"/>
                  </td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>

        <!-- PAGER -->
        <div class="d-flex align-items-center justify-content-between py-2">
          <div>
            <t t-set="total" t-value="totalDriverCount()"/>
            <t t-set="start" t-value="Math.min(total, ((state.page-1)*state.pageSize)+1)"/>
            <t t-set="end"   t-value="Math.min(total, (state.page*state.pageSize))"/>
            <small class="text-muted">
              Showing <t t-esc="start"/>–<t t-esc="end"/> of <t t-esc="total"/>
            </small>
          </div>
          <div class="btn-group">
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page===1"
                    t-on-click="() => goToPage(1)">« First</button>
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page===1"
                    t-on-click="prevPage">‹ Prev</button>

            <t t-foreach="pageWindow()" t-as="pg" t-key="pg">
              <t t-if="pg === '…'">
                <button class="btn btn-outline-primary" disabled="disabled">…</button>
              </t>
              <t t-elif="state.page === pg">
                <button class="btn btn-primary active"
                        disabled="disabled"
                        aria-current="page">
                  <t t-esc="pg"/>
                </button>
              </t>
              <t t-else="">
                <button class="btn btn-outline-primary"
                        t-on-click="() => goToPage(pg)">
                  <t t-esc="pg"/>
                </button>
              </t>
            </t>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="nextPage">Next ›</button>
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="() => goToPage(pageCount())">Last »</button>
          </div>
        </div>

        <!-- MODAL (driver detail) -->
        <t t-if="state.showModal">
          <div class="modal d-block"
               tabindex="-1"
               t-ref="lp_modal"
               style="background:rgba(0,0,0,0.4)">
            <div class="modal-dialog modal-xl" style="max-width: 80vw;">
              <div class="modal-content">

                <div class="modal-header">
                  <h5 class="modal-title">Driver Details</h5>
                </div>

                <div class="modal-body">
                  <div class="row">
                    <!-- LEFT -->
                    <div class="col-md-3">
                      <div><strong>Name:</strong> <t t-esc="state.modalDriver.name"/></div>
                      <div><strong>Phone:</strong> <t t-esc="state.modalDriver.phone"/></div>
                      <div><strong>Product:</strong> <t t-esc="state.modalDriver.product_type"/></div>
                      <div><strong>Hire Date:</strong> <t t-esc="state.modalDriver.hire_date"/></div>
                      <div><strong>Risk:</strong> <t t-esc="state.modalDriver.risk"/></div>
                      <div><strong>Driver Quality:</strong> <t t-esc="state.modalDriver.quality_score"/></div>
                    </div>

                    <!-- RIGHT -->
                    <div class="col-md-9">
                      <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-primary"
                                t-on-click="toggleModalView">
                          <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
                        </button>
                      </div>

                      <t t-if="!state.showCharts">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <div class="card"><div class="card-body">
                              <h6>Gross Revenue</h6>
                              <h3><t t-esc="formatNumber(state.modalDriver.cards?.cash || 0, 0)"/></h3>
                            </div></div>
                          </div>
                          <div class="col-md-4">
                            <div class="card"><div class="card-body">
                              <h6>Trips</h6>
                              <h3><t t-esc="formatNumber(state.modalDriver.cards?.trips || 0)"/></h3>
                            </div></div>
                          </div>
                          <div class="col-md-4">
                            <div class="card"><div class="card-body">
                              <h6>Hours Online</h6>
                              <h3><t t-esc="formatNumber(state.modalDriver.cards?.hours || 0, 0)"/></h3>
                            </div></div>
                          </div>
                          <div class="col-md-4">
                            <div class="card"><div class="card-body">
                              <h6>Acceptance %</h6>
                              <h3><t t-esc="formatNumber(state.modalDriver.cards?.acceptance_rate || 0, 1)"/>%</h3>
                            </div></div>
                          </div>
                          <div class="col-md-4">
                            <div class="card"><div class="card-body">
                              <h6>Completion %</h6>
                              <h3><t t-esc="formatNumber(state.modalDriver.cards?.completion_rate || 0, 1)"/>%</h3>
                            </div></div>
                          </div>
                        </div>
                      </t>
                      <t t-else="">
                        <div class="row g-3">
                          <div class="col-md-6">
                            <div class="card"><div class="card-body">
                              <h6>Gross Revenue</h6>
                              <canvas id="lp_chart_cash" height="160"></canvas>
                            </div></div>
                          </div>
                          <div class="col-md-6">
                            <div class="card"><div class="card-body">
                              <h6>Trips</h6>
                              <canvas id="lp_chart_trips" height="160"></canvas>
                            </div></div>
                          </div>
                          <div class="col-md-6">
                            <div class="card"><div class="card-body">
                              <h6>Hours Online</h6>
                              <canvas id="lp_chart_hours" height="160"></canvas>
                            </div></div>
                          </div>
                          <div class="col-md-6">
                            <div class="card"><div class="card-body">
                              <h6>Acceptance Rate %</h6>
                              <canvas id="lp_chart_acc" height="160"></canvas>
                            </div></div>
                          </div>
                          <div class="col-md-6">
                            <div class="card"><div class="card-body">
                              <h6>Completion Rate %</h6>
                              <canvas id="lp_chart_comp" height="160"></canvas>
                            </div></div>
                          </div>
                        </div>
                      </t>
                    </div>
                  </div>

                  <div class="mt-4">
                    <h6>Issues</h6>
                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>Category</th>
                            <th>Date Reported</th>
                            <th>Date Resolved</th>
                            <th>Reporter Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-if="!state.modalDriver.issues || !state.modalDriver.issues.length">
                            <tr><td colspan="3"><em>No issues in this window.</em></td></tr>
                          </t>
                          <t t-else="">
                            <t t-foreach="state.modalDriver.issues"
                               t-as="it"
                               t-key="it.date_reported + it.category_path">
                              <tr style="vertical-align: top;">
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.category_path"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_reported"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_resolved or ''"/>
                                </td>
                                <td style="white-space: pre-wrap;">
                                  <t t-esc="it.note"/>
                                </td>
                              </tr>
                            </t>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn btn-secondary"
                          t-on-click="closeModal">Close</button>
                </div>

              </div>
            </div>
          </div>
        </t>

      </t>
    </div>
  </t>
</templates>
