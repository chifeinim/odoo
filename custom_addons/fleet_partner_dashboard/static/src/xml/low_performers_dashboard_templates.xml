<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlLowPerformersDashboard" owl="1">
    <div class="o_fleet_dashboard" style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;">
      <t t-if="state.loading"><div>Loading…</div></t>
      <t t-else="">
        <h1 class="mb-4 d-flex align-items-center">
        <span>Low Performers</span>
        <i class="fa fa-info-circle text-muted"
            t-att-title="state.infoText"
            style="cursor: help; font-size: 0.9em; margin-left: 8px;"
            aria-label="Information"></i>
        </h1>

        <!-- FILTER BAR -->
        <div class="mb-3 p-3 bg-light rounded d-flex align-items-center gap-2 flex-wrap">
          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.selectedProducts.length">(<t t-esc="state.selectedProducts.length"/>)</t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showProducts}" style="max-height:200px;overflow:auto">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Quality -->
          <div class="dropdown" t-att-class="{'show': state.showScores}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showScores')">
              Driver Quality
              <t t-if="state.selectedScores.length">(<t t-esc="state.selectedScores.length"/>)</t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showScores}">
              <t t-foreach="[
                  {key:'Low Performer',label:'Low Performer'},
                  {key:'Average Performer',label:'Average Performer'},
                  {key:'High Performer',label:'High Performer'}
                ]" t-as="sc" t-key="sc.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedScores.includes(sc.key)}"
                        t-on-click="() => toggleFilter('selectedScores', sc.key)">
                  <t t-esc="sc.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown" t-att-class="{'show': state.showCategories}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showCategories')">
              Driver Category
              <t t-if="state.selectedCategories.length">(<t t-esc="state.selectedCategories.length"/>)</t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showCategories}" style="max-height:220px;overflow:auto">
              <t t-foreach="state.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Risk -->
          <div class="dropdown" t-att-class="{'show': state.showRisks}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showRisks')">
              Risk
              <t t-if="state.selectedRisks.length">(<t t-esc="state.selectedRisks.length"/>)</t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showRisks}">
              <t t-foreach="state.risks" t-as="rk" t-key="rk.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedRisks.includes(rk.key)}"
                        t-on-click="() => toggleFilter('selectedRisks', rk.key)">
                  <t t-esc="rk.label"/>
                </button>
              </t>
            </div>
          </div>

            <!-- Issues Reported -->
            <div class="dropdown" t-att-class="{'show': state.showIssues}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showIssues')">
                Issues Reported
                <t t-if="state.selectedIssues.length">(<t t-esc="state.selectedIssues.length"/>)</t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showIssues}">
                <t t-foreach="[{key:'Yes',label:'Yes'},{key:'No',label:'No'}]" t-as="opt" t-key="opt.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedIssues.includes(opt.key)}"
                        t-on-click="() => toggleFilter('selectedIssues', opt.key)">
                    <t t-esc="opt.label"/>
                </button>
                </t>
            </div>
            </div>

          <!-- Period -->
          <div class="dropdown" t-att-class="{'show': state.showPeriod}">
            <button class="btn btn-primary dropdown-toggle" t-on-click="() => toggleDropdown('showPeriod')">
              Date
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showPeriod}">
              <t t-foreach="state.timePeriods" t-as="p" t-key="p">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedPeriod === p}"
                        t-on-click="() => changePeriod(p)">
                  <t t-esc="p"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Manual dates -->
          <div class="d-flex align-items-center gap-2 ms-auto">
            <input type="date" class="form-control" style="min-width: 180px" t-on-change="onStartDateChange"/>
            <span>to</span>
            <input type="date" class="form-control" style="min-width: 180px" t-on-change="onEndDateChange"/>
          </div>
        </div>

        <!-- SEARCH -->
        <div class="mb-3">
          <input type="text" class="form-control" placeholder="Search name or phone…" t-on-input="onSearchChange"/>
        </div>

        <!-- TABLE -->
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>
                <a href="#" t-on-click="() => setSort('name')">
                    Name <span class="ms-1" t-if="state.sortKey === 'name'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>Phone No.</th>
                <th>
                <a href="#" t-on-click="() => setSort('risk')">
                    Risk <span class="ms-1" t-if="state.sortKey === 'risk'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>
                <a href="#" t-on-click="() => setSort('trips')">
                    Trips <span class="ms-1" t-if="state.sortKey === 'trips'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>
                <a href="#" t-on-click="() => setSort('hours')">
                    Hours Online <span class="ms-1" t-if="state.sortKey === 'hours'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>
                <a href="#" t-on-click="() => setSort('cash')">
                    Gross Revenue (Kz)<span class="ms-1" t-if="state.sortKey === 'cash'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>
                <a href="#" t-on-click="() => setSort('acceptance_rate')">
                    Acceptance % <span class="ms-1" t-if="state.sortKey === 'acceptance_rate'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>
                <a href="#" t-on-click="() => setSort('completion_rate')">
                    Completion % <span class="ms-1" t-if="state.sortKey === 'completion_rate'"><t t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></span>
                </a>
                </th>
                <th>Issues Reported</th>
              </tr>
            </thead>
            <tbody>
            <t t-foreach="pagedDrivers()" t-as="d" t-key="d.id">
                <tr>
                <td>
                    <a href="#" t-on-click="() => openDriver(d)"><t t-esc="d.name"/></a>
                </td>
                <td><t t-esc="d.phone"/></td>

                <!-- RISK: full-cell color -->
                <td
                t-att-class="(d.risk === 'High' ? 'bg-danger text-dark fw-bold' : (d.risk === 'Medium' ? 'bg-warning text-dark fw-bold' : ''))"
                t-att-style="d.risk === 'High' ? 'background-color:#f8d7da !important;' : (d.risk === 'Medium' ? 'background-color:#fff3cd !important;' : '')"
                >
                <t t-esc="d.risk"/>
                </td>

                <td><t t-esc="formatNumber(d.trips)"/></td>
                <td><t t-esc="formatNumber(d.hours, 0)"/></td>
                <td><t t-esc="formatNumber(d.cash, 0)"/></td>
                <td><t t-esc="formatNumber(d.acceptance_rate, 1)"/>%</td>
                <td><t t-esc="formatNumber(d.completion_rate, 1)"/>%</td>

                <!-- ISSUES: red only when Yes -->
                <td
                t-att-class="d.issues_reported === 'Yes' ? 'bg-danger text-dark fw-bold' : ''"
                t-att-style="d.issues_reported === 'Yes' ? 'background-color:#f8d7da !important;' : ''"
                t-att-aria-label="'Issues reported: ' + d.issues_reported"
                >
                <t t-esc="d.issues_reported"/>
                </td>
                </tr>
            </t>
            </tbody>
          </table>
        </div>

        <!-- PAGER -->
        <div class="d-flex align-items-center justify-content-between py-2">
          <div>
            <t t-set="total" t-value="totalDriverCount()"/>
            <t t-set="start" t-value="Math.min(total, ((state.page-1)*state.pageSize)+1)"/>
            <t t-set="end"   t-value="Math.min(total, (state.page*state.pageSize))"/>
            <small class="text-muted">
              Showing <t t-esc="start"/>–<t t-esc="end"/> of <t t-esc="total"/>
            </small>
          </div>
          <div class="btn-group">
            <button class="btn btn-outline-primary" t-att-disabled="state.page===1" t-on-click="() => goToPage(1)">« First</button>
            <button class="btn btn-outline-primary" t-att-disabled="state.page===1" t-on-click="prevPage">‹ Prev</button>

            <t t-foreach="pageWindow()" t-as="pg" t-key="pg">
              <t t-if="pg === '…'">
                <button class="btn btn-outline-primary" disabled="disabled">…</button>
              </t>
              <t t-elif="state.page === pg">
                <button class="btn btn-primary active" disabled="disabled" aria-current="page"><t t-esc="pg"/></button>
              </t>
              <t t-else="">
                <button class="btn btn-outline-primary" t-on-click="() => goToPage(pg)"><t t-esc="pg"/></button>
              </t>
            </t>

            <button class="btn btn-outline-primary" t-att-disabled="state.page >= pageCount()" t-on-click="nextPage">Next ›</button>
            <button class="btn btn-outline-primary" t-att-disabled="state.page >= pageCount()" t-on-click="() => goToPage(pageCount())">Last »</button>
          </div>
        </div>

        <!-- MODAL (driver detail) -->
        <t t-if="state.showModal">
        <div class="modal d-block" tabindex="-1" t-ref="lp_modal" style="background:rgba(0,0,0,0.4)">
            <div class="modal-dialog modal-xl" style="max-width: 80vw;">
            <div class="modal-content">
                <div class="modal-header">
                <h5 class="modal-title">Driver Details</h5>
                <!-- removed small top-right close button -->
                </div>
                <div class="modal-body">
                <div class="row">
                    <!-- LEFT: identity -->
                    <div class="col-md-3">
                    <div><strong>Name:</strong> <t t-esc="state.modalDriver.name"/></div>
                    <div><strong>Phone:</strong> <t t-esc="state.modalDriver.phone"/></div>
                    <div><strong>Product:</strong> <t t-esc="state.modalDriver.product_type"/></div>
                    <div><strong>Hire Date:</strong> <t t-esc="state.modalDriver.hire_date"/></div>
                    <div><strong>Risk:</strong> <t t-esc="state.modalDriver.risk"/></div>
                    <div><strong>Driver Quality:</strong> <t t-esc="state.modalDriver.quality_score"/></div>
                    </div>

                    <!-- CENTER/RIGHT: cards OR charts -->
                    <div class="col-md-9">
                    <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-primary" t-on-click="toggleModalView">
                        <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
                        </button>
                    </div>

                    <t t-if="!state.showCharts">
                        <!-- cards fed by /driver_detail totals -->
                        <div class="row g-3">
                        <div class="col-md-4"><div class="card"><div class="card-body"><h6>Gross Revenue</h6><h3><t t-esc="formatNumber(state.modalDriver.cards?.cash || 0, 0)"/></h3></div></div></div>
                        <div class="col-md-4"><div class="card"><div class="card-body"><h6>Trips</h6><h3><t t-esc="formatNumber(state.modalDriver.cards?.trips || 0)"/></h3></div></div></div>
                        <div class="col-md-4"><div class="card"><div class="card-body"><h6>Hours Online</h6><h3><t t-esc="formatNumber(state.modalDriver.cards?.hours || 0, 0)"/></h3></div></div></div>
                        <div class="col-md-4"><div class="card"><div class="card-body"><h6>Acceptance %</h6><h3><t t-esc="formatNumber(state.modalDriver.cards?.acceptance_rate || 0, 1)"/>%</h3></div></div></div>
                        <div class="col-md-4"><div class="card"><div class="card-body"><h6>Completion %</h6><h3><t t-esc="formatNumber(state.modalDriver.cards?.completion_rate || 0, 1)"/>%</h3></div></div></div>
                        </div>
                    </t>
                    <t t-else="">
                        <!-- charts (bar) -->
                        <div class="row g-3">
                        <div class="col-md-6"><div class="card"><div class="card-body"><h6>Gross Revenue</h6><canvas id="lp_chart_cash" height="160"></canvas></div></div></div>
                        <div class="col-md-6"><div class="card"><div class="card-body"><h6>Trips</h6><canvas id="lp_chart_trips" height="160"></canvas></div></div></div>
                        <div class="col-md-6"><div class="card"><div class="card-body"><h6>Hours Online</h6><canvas id="lp_chart_hours" height="160"></canvas></div></div></div>
                        <div class="col-md-6"><div class="card"><div class="card-body"><h6>Acceptance Rate %</h6><canvas id="lp_chart_acc" height="160"></canvas></div></div></div>
                        <div class="col-md-6"><div class="card"><div class="card-body"><h6>Completion Rate %</h6><canvas id="lp_chart_comp" height="160"></canvas></div></div></div>
                        </div>
                    </t>
                    </div>
                </div>

                <!-- Issues table (newest first, full notes) -->
                <div class="mt-4">
                    <h6>Issues</h6>
                    <div class="table-responsive">
                    <table class="table table-sm">
                        <thead><tr><th>Category</th><th>Date Reported</th><th>Date Resolved</th><th>Reporter Note</th></tr></thead>
                        <tbody>
                        <t t-if="!state.modalDriver.issues || !state.modalDriver.issues.length">
                            <tr><td colspan="3"><em>No issues in this window.</em></td></tr>
                        </t>
                        <t t-else="">
                            <t t-foreach="state.modalDriver.issues" t-as="it" t-key="it.date_reported + it.category_path">
                            <tr style="vertical-align: top;">
                                <td style="white-space: nowrap;"><t t-esc="it.category_path"/></td>
                                <td style="white-space: nowrap;"><t t-esc="it.date_reported"/></td>
                                <td style="white-space: nowrap;"><t t-esc="it.date_resolved or ''"/></td>
                                <td style="white-space: pre-wrap;"><t t-esc="it.note"/></td>
                            </tr>
                            </t>
                        </t>
                        </tbody>
                    </table>
                    </div>
                </div>
                </div>

                <div class="modal-footer">
                <button class="btn btn-secondary" t-on-click="closeModal">Close</button>
                </div>
            </div>
            </div>
        </div>
        </t>
      </t>
    </div>
  </t>
</templates>
