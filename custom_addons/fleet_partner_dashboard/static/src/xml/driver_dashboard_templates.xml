<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlDriverDashboard" owl="1">
    <div class="o_fleet_dashboard" style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;">
      <t t-if="state.loading" t-key="'loading'">
        <div>Loading…</div>
      </t>
      <t t-elif="state.error"  t-key="'error'">
        <div class="alert alert-danger">
          <t t-esc="state.error.message || state.error"/>
        </div>
      </t>
      <t t-else="" t-key="'content'">
        <!-- CATEGORY FILTER DROPDOWN -->
        <div class="dropdown mb-3" t-att-class="{'show': state.dropdownOpen}">
          <button
            type="button"
            class="btn btn-primary dropdown-toggle"
            t-on-click="toggleDropdown">
            Filter by main category
            <t t-if="state.selectedCats.length">
              (<t t-esc="state.selectedCats.length"/>)
            </t>
          </button>
          <div
            class="dropdown-menu p-2"
            t-att-class="{'show': state.dropdownOpen}"
            style="max-height:200px; overflow:auto;">
            <t t-foreach="state.catsSummary" t-as="cat" t-key="cat.name">
              <button
                type="button"
                class="dropdown-item"
                t-att-class="{'active': state.selectedCats.includes(cat.name)}"
                t-on-click="toggleCategory(cat.name)">
                <t t-esc="cat.name"/>
              </button>
            </t>
          </div>
        </div>

        <!-- CATEGORY SUMMARY TABLE -->
        <h2>Issues by Main Category</h2>
        <table class="table table-bordered mb-4">
          <thead>
            <tr>
              <th>Category</th>
              <th>Last 3 Months</th>
              <th>Last Month</th>
              <th>Last 7 Days</th>
            </tr>
          </thead>
          <tbody>
            <t
              t-foreach="state.catsSummary.filter(cat => !state.selectedCats.length || state.selectedCats.includes(cat.name))"
              t-as="cat"
              t-key="cat.name">
              <tr>
                <td><t t-esc="cat.name"/></td>
                <td><t t-esc="cat.counts[0]"/></td>
                <td><t t-esc="cat.counts[1]"/></td>
                <td><t t-esc="cat.counts[2]"/></td>
              </tr>
            </t>
          </tbody>
        </table>

        <!-- SEARCH BAR -->
        <h2>Issues by Driver</h2>
        <div class="form-group mb-3">
          <input
            type="text"
            class="form-control"
            placeholder="Search driver..."
            t-model="state.search"/>
        </div>

        <!-- DRIVER PERIODS TABLE -->
        <table class="table table-striped">
          <thead>
            <tr>
              <th>Driver</th>
              <th>Phone</th>
              <t t-foreach="state.windows" t-as="w" t-key="w">
                <th><t t-esc="w"/></th>
              </t>
            </tr>
          </thead>
          <tbody>
            <t
              t-foreach="state.drivers
                          .filter(d => d.name.toLowerCase().includes(state.search.toLowerCase()))"
              t-as="d"
              t-key="d.name">
              <tr>
                <td><t t-esc="d.name"/></td>
                <td><t t-esc="d.phone"/></td>
                <t t-foreach="d.periods" t-as="p" t-key="p.label">
                  <td>
                    <t t-if="p.cats.length">
                      <ul class="o_dashboard_list">
                        <t t-foreach="p.cats" t-as="cat" t-key="cat.name">
                          <li>
                            <span
                              class="badge"
                              t-att-class="{
                                'badge-success': cat.color === 3,
                                'badge-warning': cat.color === 1,
                                'badge-danger':  cat.color === 2
                              }"
                            >
                              <t t-esc="cat.name"/>
                            </span>
                          </li>
                        </t>
                      </ul>
                    </t>
                    <t t-else="">
                      <span class="text-muted">(none)</span>
                    </t>
                  </td>
                </t>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </div>
  </t>
</templates>
