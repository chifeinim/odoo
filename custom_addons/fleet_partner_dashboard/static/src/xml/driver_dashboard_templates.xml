<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlDriverDashboard" owl="1">
    <div class="o_fleet_dashboard">
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-elif="state.error">
        <div class="alert alert-danger">
          <t t-esc="state.error.message || state.error"/>
        </div>
      </t>
      <t t-else="">
      <!-- TAG FILTER -->
        <div class="form-group mb-3">
        <label for="tag-filter">Filter by tag:</label>
        <select id="tag-filter"
                class="form-control"
                t-model="state.selectedTags"
                multiple="multiple"
                size="5">
            <t t-foreach="state.tagsSummary" t-as="tag" t-key="tag.name">
            <option t-att-value="tag.name">
                <t t-esc="tag.name"/>
            </option>
            </t>
        </select>
        <small class="form-text text-muted">
            (hold Ctrl/Cmd to select multiple)
        </small>
        </div>

      <!-- TAG‐SUMMARY TABLE -->
        <h2>Issues by Tag</h2>
        <table class="table table-bordered mb-4">
        <thead>
            <tr>
            <th>Tag</th>
            <th>Last 3 Months</th>
            <th>Last Month</th>
            <th>Last 7 Days</th>
            </tr>
        </thead>
        <tbody>
            <t t-foreach="
                state.tagsSummary
                    .filter(t => !state.selectedTags.length
                                || state.selectedTags.includes(t.name))
                " t-as="tag" t-key="tag.name">
            <tr>
                <td><t t-esc="tag.name"/></td>
                <!-- counts[0]=90d, [1]=30d, [2]=7d -->
                <td><t t-esc="tag.counts[0]"/></td>
                <td><t t-esc="tag.counts[1]"/></td>
                <td><t t-esc="tag.counts[2]"/></td>
            </tr>
            </t>
        </tbody>
        </table>

        <!-- Search bar -->
        <h2>Issues by Driver</h2>
        <div class="form-group mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="Search driver..."
                 t-model="state.search"/>
        </div>

        <table class="table table-striped">
          <thead>
            <tr>
              <th>Driver</th>
              <th>Phone</th>
              <t t-foreach="state.windows" t-as="w" t-key="w">
                <th t-esc="w"/>
              </t>
            </tr>
          </thead>
          <tbody>
            <!-- Only drivers whose name includes the search term (case-insensitive) -->
            <t t-foreach="state.drivers
                          .filter(d => d.name.toLowerCase().includes(state.search.toLowerCase()))"
                t-as="d"
                t-key="d.name">
              <tr>
                <td><t t-esc="d.name"/></td>
                <td t-esc="d.phone"/>
                <t t-foreach="d.periods" t-as="p" t-key="p.label">
                  <td>
                    <t t-if="p.tags.length">
                      <ul class="o_dashboard_list">
                        <t t-foreach="p.tags" t-as="tag" t-key="tag">
                          <li t-esc="tag"/>
                        </t>
                      </ul>
                    </t>
                    <t t-else="">
                      <span class="text-muted">(none)</span>
                    </t>
                  </td>
                </t>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </div>
  </t>
</templates>
