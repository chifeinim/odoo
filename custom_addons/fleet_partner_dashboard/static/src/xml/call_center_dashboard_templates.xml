<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlCallCenterDashboard" owl="1">
    <div class="o_fleet_dashboard" style="height: calc(100vh - 70px); overflow-y:auto; padding:1rem;">
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">

        <h1 class="mb-3">Call Center</h1>

        <!-- FILTERS -->
        <div class="mb-3 p-3 bg-light rounded d-flex align-items-center gap-2 flex-wrap">
          <!-- Product -->
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              Product
              <t t-if="state.selectedProducts.length">(<t t-esc="state.selectedProducts.length"/>)</t>
            </button>
            <div class="dropdown-menu" style="max-height:220px;overflow:auto;">
              <t t-foreach="state.filters.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              Driver Category
              <t t-if="state.selectedCategories.length">
                (<t t-esc="state.selectedCategories.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" style="max-height:220px;overflow:auto;">
              <t t-foreach="state.filters.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Issue Types -->
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              Issue Types
              <t t-if="state.selectedIssueTypes.length">
                (<t t-esc="state.selectedIssueTypes.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" style="max-height:220px;overflow:auto;">
              <t t-foreach="state.filters.issueTypes" t-as="it" t-key="it.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedIssueTypes.includes(it.key)}"
                        t-on-click="() => toggleFilter('selectedIssueTypes', it.key)">
                  <t t-esc="it.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Statuses -->
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              Statuses
              <t t-if="state.selectedStatuses.length">
                (<t t-esc="state.selectedStatuses.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" style="max-height:220px;overflow:auto;">
              <t t-foreach="state.filters.statuses" t-as="st" t-key="st.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedStatuses.includes(st.key)}"
                        t-on-click="() => toggleFilter('selectedStatuses', st.key)">
                  <t t-esc="st.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Period -->
          <div class="dropdown">
            <button class="btn btn-primary dropdown-toggle" data-bs-toggle="dropdown" type="button">
              <t t-esc="state.selectedPeriod || 'Date'"/>
            </button>
            <div class="dropdown-menu">
              <t t-foreach="state.filters.timePeriods" t-as="p" t-key="p">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedPeriod === p}"
                        t-on-click="() => changePeriod(p)">
                  <t t-esc="p"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Manual dates -->
          <div class="ms-auto d-flex align-items-center gap-2">
            <input type="date"
                   class="form-control"
                   style="min-width: 160px;"
                   t-att-value="state.startDate"
                   t-on-change="onStartDateChange"/>
            <span>to</span>
            <input type="date"
                   class="form-control"
                   style="min-width: 160px;"
                   t-att-value="state.endDate"
                   t-on-change="onEndDateChange"/>
          </div>

          <button class="btn btn-primary ms-2" t-on-click="applyFilters">Apply</button>
        </div>

        <!-- SEARCH -->
        <div class="mb-3">
          <input type="text" class="form-control"
                 placeholder="Search by name or phone…"
                 t-on-input="onBoardSearch"/>
        </div>

        <!-- BOARD TABLE -->
        <div class="table-responsive">
          <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th style="cursor:pointer" t-on-click="() => setSort('name')">
                  Driver
                  <t t-if="state.sortKey === 'name'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>
                <th>Phone</th>
                <th>Product</th>
                <th>Category</th>
                <th style="cursor:pointer" t-on-click="() => setSort('issues_total')">
                  Issues
                  <t t-if="state.sortKey === 'issues_total'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>
                <th>By Type</th>
              </tr>
            </thead>
            <tbody>
              <t t-if="!boardRows().length">
                <tr><td colspan="6"><em>No drivers found for these filters.</em></td></tr>
              </t>
              <t t-else="">
                <t t-foreach="boardRows()" t-as="d" t-key="d.id">
                  <tr>
                    <td>
                      <a href="#" t-on-click="() => openDriver(d)">
                        <t t-esc="d.name"/>
                      </a>
                    </td>
                    <td><t t-esc="d.phone"/></td>
                    <td><t t-esc="d.product_type"/></td>
                    <td><t t-esc="d.category"/></td>
                    <td><t t-esc="d.issues_total"/></td>
                    <td>
                      <t t-if="!d.issues_by_type || !d.issues_by_type.length">
                        <span class="text-muted">–</span>
                      </t>
                      <t t-else="">
                        <t t-foreach="d.issues_by_type" t-as="it" t-key="it.issue_type">
                          <span class="badge bg-secondary me-1 mb-1">
                            <t t-esc="it.label"/>: <t t-esc="it.count"/>
                          </span>
                        </t>
                      </t>
                    </td>
                  </tr>
                </t>
              </t>
            </tbody>
          </table>
        </div>

        <!-- DRIVER MODAL -->
        <t t-if="state.driverModalOpen">
          <div class="modal d-block" tabindex="-1" t-ref="driverModal">
            <div class="modal-dialog modal-xl" style="max-width: 80vw;">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">
                    Call Center – Driver
                    <t t-if="state.driverDetail and state.driverDetail.driver">
                      <t t-esc="state.driverDetail.driver.name"/>
                    </t>
                  </h5>
                  <button type="button" class="btn-close" t-on-click="closeDriverModal"/>
                </div>
                <div class="modal-body">
                  <t t-if="!state.driverDetail">
                    <div>Loading…</div>
                  </t>
                  <t t-else="">
                    <div class="mb-3">
                    <strong>Phone:</strong>
                    <t t-esc="state.driverDetail.driver.phone"/>
                    <span class="mx-2">•</span>
                    <strong>Product:</strong>
                    <t t-esc="state.driverDetail.driver.product_type"/>
                    </div>

                    <!-- CARDS -->
                    <div class="row g-3 mb-3">
                      <div class="col-md-3">
                        <div class="card"><div class="card-body">
                          <h6>Gross Revenue</h6>
                          <h3><t t-esc="formatNumber(state.driverDetail.cards.cash || 0, 0)"/></h3>
                        </div></div>
                      </div>
                      <div class="col-md-3">
                        <div class="card"><div class="card-body">
                          <h6>Trips</h6>
                          <h3><t t-esc="formatNumber(state.driverDetail.cards.trips || 0)"/></h3>
                        </div></div>
                      </div>
                      <div class="col-md-3">
                        <div class="card"><div class="card-body">
                          <h6>Hours Online</h6>
                          <h3><t t-esc="formatNumber(state.driverDetail.cards.hours || 0, 0)"/></h3>
                        </div></div>
                      </div>
                      <div class="col-md-3">
                        <div class="card"><div class="card-body">
                          <h6>Trips / Hour</h6>
                          <h3><t t-esc="formatNumber(state.driverDetail.cards.trips_per_hour || 0, 2)"/></h3>
                        </div></div>
                      </div>
                    </div>

                    <!-- ISSUES TABLE -->
                    <h6>Issues</h6>
                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>Issue ID</th>
                            <th>Type</th>
                            <th>Category</th>
                            <th>Reported</th>
                            <th>Resolved</th>
                            <th>Status</th>
                            <th>Reporter Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-if="!state.driverDetail.issues || !state.driverDetail.issues.length">
                            <tr><td colspan="7"><em>No issues in this window.</em></td></tr>
                          </t>
                          <t t-else="">
                            <t t-foreach="state.driverDetail.issues" t-as="it" t-key="it.id">
                              <tr>
                                <td style="white-space:nowrap;">
                                  <a href="#" t-on-click="() => openIssue(it)">
                                    <t t-esc="it.name"/>
                                  </a>
                                </td>
                                <td style="white-space:nowrap;"><t t-esc="it.issue_type"/></td>
                                <td style="white-space:nowrap;"><t t-esc="it.category_path"/></td>
                                <td style="white-space:nowrap;"><t t-esc="it.date_reported"/></td>
                                <td style="white-space:nowrap;"><t t-esc="it.date_resolved"/></td>
                                <td style="white-space:nowrap;">
                                  <button class="btn btn-sm btn-outline-primary"
                                          t-on-click="() => openStatusModal(it)">
                                    <t t-esc="it.status_label or it.status"/>
                                  </button>
                                </td>
                                <td style="white-space:pre-wrap;"><t t-esc="it.reporter_note"/></td>
                              </tr>
                            </t>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </t>
                </div>
              </div>
            </div>
          </div>
        </t>

        <!-- ISSUE DETAIL MODAL -->
        <t t-if="state.issueModalOpen">
          <div class="modal d-block" tabindex="-1" t-ref="issueModal">
            <div class="modal-dialog modal-lg">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">
                    Issue
                    <t t-if="state.issueDetail and state.issueDetail.issue">
                      <t t-esc="state.issueDetail.issue.name"/>
                    </t>
                  </h5>
                  <button type="button" class="btn-close" t-on-click="closeIssueModal"/>
                </div>
                <div class="modal-body">
                  <t t-if="!state.issueDetail">
                    <div>Loading…</div>
                  </t>
                  <t t-else="">
                    <div class="mb-3">
                    <strong>Driver:</strong>
                    <t t-esc="state.issueDetail.issue.driver.name"/>
                    <span class="mx-2">•</span>
                    <strong>Phone:</strong>
                    <t t-esc="state.issueDetail.issue.driver.phone"/>
                    </div>
                    <div class="mb-3">
                      <strong>Type:</strong>
                      <t t-esc="state.issueDetail.issue.issue_type"/>
                      <br/>
                    <strong>Category:</strong>
                    <t t-esc="state.issueDetail.issue.main_category"/>
                    <t t-if="state.issueDetail.issue.sub_category">
                    <span class="mx-1">›</span>
                    <t t-esc="state.issueDetail.issue.sub_category"/>
                    </t>
                    <t t-if="state.issueDetail.issue.sub_sub_category">
                    <span class="mx-1">›</span>
                    <t t-esc="state.issueDetail.issue.sub_sub_category"/>
                    </t>
                      <br/>
                      <strong>Status:</strong>
                      <t t-esc="state.issueDetail.issue.status_label"/>
                    </div>
                    <div class="mb-3">
                      <strong>Reporter Note:</strong>
                      <div style="white-space:pre-wrap;">
                        <t t-esc="state.issueDetail.issue.note"/>
                      </div>
                    </div>

                    <h6>Call Notes</h6>
                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>Date</th>
                            <th>Author</th>
                            <th>Status Change</th>
                            <th>Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-if="!state.issueDetail.call_notes || !state.issueDetail.call_notes.length">
                            <tr><td colspan="4"><em>No call notes.</em></td></tr>
                          </t>
                          <t t-else="">
                            <t t-foreach="state.issueDetail.call_notes" t-as="cn" t-key="cn.id">
                              <tr>
                                <td style="white-space:nowrap;"><t t-esc="cn.created_at"/></td>
                                <td style="white-space:nowrap;"><t t-esc="cn.author"/></td>
                                <td style="white-space:nowrap;">
                                  <t t-esc="cn.status_from_label"/> →
                                  <t t-esc="cn.status_to_label"/>
                                </td>
                                <td style="white-space:pre-wrap;"><t t-esc="cn.note"/></td>
                              </tr>
                            </t>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </t>
                </div>
              </div>
            </div>
          </div>
        </t>

        <!-- STATUS CHANGE MODAL -->
        <t t-if="state.statusModalOpen">
          <div class="modal d-block" tabindex="-1" t-ref="statusModal">
            <div class="modal-dialog">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Update Issue Status</h5>
                  <button type="button" class="btn-close" t-on-click="closeStatusModal"/>
                </div>
                <div class="modal-body">
                  <div class="mb-2">
                    <strong>Current status:</strong>
                    <t t-esc="state.statusModal.current_status_label"/>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">New status</label>
                    <select class="form-select" t-on-change="onStatusChange">
                      <t t-foreach="state.filters.statuses" t-as="st" t-key="st.key">
                        <option t-att-value="st.key"
                                t-att-selected="st.key === state.statusModal.new_status">
                          <t t-esc="st.label"/>
                        </option>
                      </t>
                    </select>
                  </div>
                  <div class="mb-3">
                    <label class="form-label">Call note (required)</label>
                    <textarea class="form-control" rows="3"
                              placeholder="Describe the outcome of the call…"
                              t-on-input="onStatusNote">
                      <t t-esc="state.statusModal.note"/>
                    </textarea>
                  </div>
                </div>
                <div class="modal-footer">
                  <button type="button" class="btn btn-secondary"
                          t-on-click="closeStatusModal">Cancel</button>
                  <button type="button" class="btn btn-primary"
                          t-on-click="submitStatusChange">
                    Save
                  </button>
                </div>
              </div>
            </div>
          </div>
        </t>

      </t>
    </div>
  </t>
</templates>
