<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlCallCenterDashboard" owl="1">

    <div class="o_fleet_dashboard"
         style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;">

      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">

        <!-- Title -->
        <h1 class="mb-4">Call Center Workflow</h1>

        <!-- FILTER BAR (sticky layer 1) -->
        <div t-ref="filtersBar"
             class="mb-3 p-3 bg-light rounded d-flex align-items-center gap-2 flex-wrap sticky-filters">

          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.draftSelectedProducts.length">
                (<t t-esc="state.draftSelectedProducts.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showProducts}"
                 style="max-height: 220px; overflow: auto;">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Issue Type -->
          <div class="dropdown" t-att-class="{'show': state.showIssueTypes}">
            <button class="btn btn-primary dropdown-toggle"
                    t-on-click="() => toggleDropdown('showIssueTypes')">
              Issue Type
              <t t-if="state.draftSelectedIssueTypes.length">
                (<t t-esc="state.draftSelectedIssueTypes.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showIssueTypes}">
              <t t-foreach="state.issueTypes" t-as="it" t-key="it.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.draftSelectedIssueTypes.includes(it.key)}"
                        t-on-click="() => toggleFilter('selectedIssueTypes', it.key)">
                  <t t-esc="it.label"/>
                </button>
              </t>
            </div>
          </div>

          <div class="ms-auto d-flex align-items-center gap-2">
            <button class="btn btn-primary"
                    t-att-disabled="!isDirty()"
                    t-on-click="applyFilters">
              Enter Filters
            </button>
          </div>
        </div>

        <!-- SEARCH (sticky layer 2) -->
        <div t-ref="searchBar" class="mb-3 sticky-search">
          <input type="text"
                 class="form-control"
                 placeholder="Search name or phone…"
                 t-on-input="onSearchChange"/>
        </div>

        <!-- KANBAN BOARD -->
        <div class="cc-board">
          <t t-foreach="state.columns" t-as="col" t-key="col.key">
            <div class="cc-column">
              <div class="cc-column-header">
                <div class="d-flex justify-content-between align-items-center">
                  <span class="fw-bold">
                    <t t-esc="col.label"/>
                  </span>
                  <span class="badge bg-secondary">
                    <t t-esc="visibleCards(col).length"/>
                  </span>
                </div>
              </div>
              <div class="cc-column-body">
                <t t-set="respCards" t-value="responsiveCards(col)"/>
                <t t-set="unrespCards" t-value="unresponsiveCards(col)"/>

                <t t-if="!respCards.length and !unrespCards.length">
                  <div class="text-muted small">No drivers in this status.</div>
                </t>

                <!-- responsive cards -->
                <t t-foreach="respCards" t-as="card" t-key="'r-' + card.driver_id">
                  <div class="cc-card"
                       t-on-click="() => openDriver(card)">
                    <div class="cc-card-header">
                      <div class="cc-card-title"><t t-esc="card.name"/></div>
                      <div class="cc-card-sub text-muted small">
                        <t t-esc="card.phone"/>
                      </div>
                      <div class="cc-card-sub text-muted small">
                        <t t-esc="card.product"/>
                      </div>
                    </div>
                    <div class="cc-card-body small">
                      <div>Total issues: <t t-esc="card.total_issues"/></div>
                      <div class="mt-1">
                        <t t-if="card.type_counts.support">
                          <span class="badge me-1 cc-badge-support">
                            Support: <t t-esc="card.type_counts.support"/>
                          </span>
                        </t>
                        <t t-if="card.type_counts.performance">
                          <span class="badge me-1 cc-badge-performance">
                            Performance: <t t-esc="card.type_counts.performance"/>
                          </span>
                        </t>
                        <t t-if="card.type_counts.training">
                          <span class="badge me-1 cc-badge-training">
                            Training: <t t-esc="card.type_counts.training"/>
                          </span>
                        </t>
                      </div>
                    </div>
                  </div>
                </t>

                <!-- unresponsive section -->
                <t t-if="unrespCards.length">
                  <div class="cc-unresponsive-separator">
                    <hr class="my-2"/>
                    <div class="text-muted small">Unresponsive today</div>
                  </div>

                  <t t-foreach="unrespCards" t-as="card" t-key="'u-' + card.driver_id">
                    <div class="cc-card cc-card-unresponsive"
                         t-on-click="() => openDriver(card)">
                      <div class="cc-card-header">
                        <div class="cc-card-title"><t t-esc="card.name"/></div>
                        <div class="cc-card-sub text-muted small">
                          <t t-esc="card.phone"/>
                        </div>
                        <div class="cc-card-sub text-muted small">
                          <t t-esc="card.product"/>
                        </div>
                      </div>
                      <div class="cc-card-body small">
                        <div>Total issues: <t t-esc="card.total_issues"/></div>
                        <div class="mt-1">
                          <t t-if="card.type_counts.support">
                            <span class="badge me-1 cc-badge-support">
                              Support: <t t-esc="card.type_counts.support"/>
                            </span>
                          </t>
                          <t t-if="card.type_counts.performance">
                            <span class="badge me-1 cc-badge-performance">
                              Performance: <t t-esc="card.type_counts.performance"/>
                            </span>
                          </t>
                          <t t-if="card.type_counts.training">
                            <span class="badge me-1 cc-badge-training">
                              Training: <t t-esc="card.type_counts.training"/>
                            </span>
                          </t>
                        </div>
                      </div>
                    </div>
                  </t>
                </t>
              </div>
            </div>
          </t>
        </div>

        <!-- DRIVER MODAL + nested modals -->
        <t t-if="state.showModal">
          <div class="modal d-block lp-modal-overlay"
               tabindex="-1"
               t-ref="cc_modal">

            <!-- driver detail modal -->
            <div class="modal-dialog modal-xl" style="max-width: 80vw;">
              <div class="modal-content">

                <div class="modal-header flex-column align-items-start">
                  <div class="d-flex w-100 justify-content-between align-items-start">
                    <div>
                      <h5 class="modal-title mb-1">
                        Call Center – Driver
                        <t t-if="state.modalDriver">
                          <t t-esc="' ' + state.modalDriver.name"/>
                        </t>
                      </h5>
                      <div class="small text-muted">
                        <t t-if="state.modalDriver.metrics_range">
                          Metrics window:
                          <t t-esc="formatDateYMDToDMY(state.modalDriver.metrics_range.start)"/>
                          -
                          <t t-esc="formatDateYMDToDMY(state.modalDriver.metrics_range.end)"/>
                        </t>
                      </div>
                    </div>
                    <button type="button"
                            class="close"
                            aria-label="Close"
                            t-on-click="closeModal">
                      <span aria-hidden="true">×</span>
                    </button>
                  </div>
                </div>

                <div class="modal-body">
                  <div class="row">
                    <!-- LEFT: driver info -->
                    <div class="col-md-3">
                      <div><strong>Name: </strong> <t t-esc="state.modalDriver.name"/></div>
                      <div><strong>Phone: </strong> <t t-esc="state.modalDriver.phone"/></div>
                      <div><strong>Product: </strong> <t t-esc="state.modalDriver.product"/></div>
                      <t t-if="state.modalDriver.driver_type_label">
                        <div><strong>Activity: </strong> <t t-esc="state.modalDriver.driver_type_label"/></div>
                      </t>
                      <t t-if="state.modalDriver.hire_date">
                        <div>
                          <strong>Hire Date: </strong>
                          <t t-esc="formatDateYMDToDMY(state.modalDriver.hire_date)"/>
                        </div>
                      </t>
                    </div>


                    <!-- RIGHT: cards / charts toggle -->
                    <div class="col-md-9">
                      <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-primary"
                                t-on-click="toggleModalView">
                          <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
                        </button>
                      </div>

                      <t t-if="!state.showCharts">
                        <div class="row g-3">
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Gross Revenue</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.cash || 0, 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.trips || 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Hours Online</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.hours || 0, 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips per Hour</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.trips_per_hour || 0, 2)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Acceptance %</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.acceptance_rate || 0, 1)"/>%
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Completion %</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.completion_rate || 0, 1)"/>%
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Cancelled by Driver %</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.cancelled_by_driver || 0, 1)"/>%
                                </h3>
                              </div>
                            </div>
                          </div>
                        </div>
                      </t>
                      <t t-else="">
                        <div class="row g-3">
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Gross Revenue</h6>
                                <canvas id="cc_chart_cash" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips</h6>
                                <canvas id="cc_chart_trips" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Hours Online</h6>
                                <canvas id="cc_chart_hours" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips per Hour</h6>
                                <canvas id="cc_chart_trph" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Acceptance Rate %</h6>
                                <canvas id="cc_chart_acc" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Completion Rate %</h6>
                                <canvas id="cc_chart_comp" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Cancelled by Driver %</h6>
                                <canvas id="cc_chart_cbd" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                        </div>
                      </t>
                    </div>
                  </div>

                  <!-- Issues table -->
                  <div class="mt-4">
                    <h6>Issues</h6>
                    <t t-if="state.modalDriver.issues_range">
                      <div class="text-muted small mt-1">
                        from
                        <t t-esc="formatDateYMDToDMY(state.modalDriver.issues_range.start)"/>
                        to
                        <t t-esc="formatDateYMDToDMY(state.modalDriver.issues_range.end)"/>
                      </div>
                    </t>

                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th style="white-space: nowrap;">Issue ID</th>
                            <th style="white-space: nowrap;">Type</th>
                            <th>Category</th>
                            <th style="white-space: nowrap;">Reported</th>
                            <th style="white-space: nowrap;">Resolved</th>
                            <th style="white-space: nowrap;">Status</th>
                            <th>Reporter Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-if="!state.modalDriver.issues || !state.modalDriver.issues.length">
                            <tr>
                              <td colspan="7">
                                <em>No issues in this window.</em>
                              </td>
                            </tr>
                          </t>
                          <t t-else="">
                            <t t-foreach="state.modalDriver.issues" t-as="it" t-key="it.id">
                              <tr style="vertical-align: top;">
                                <!-- clickable issue ID -> issue detail modal -->
                                <td style="white-space: nowrap;">
                                  <a href="#" t-on-click="() => openIssue(it)">
                                    <t t-esc="it.id"/>
                                  </a>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.issue_type"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.category_path"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_reported"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_resolved"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <button class="btn btn-sm btn-outline-primary"
                                          t-on-click="() => openStatusModal(it)">
                                    <t t-esc="it.status or it.status_raw"/>
                                  </button>
                                </td>
                                <td style="white-space: pre-wrap;">
                                  <t t-esc="it.reporter_note"/>
                                </td>
                              </tr>
                            </t>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn btn-secondary"
                          t-on-click="closeModal">
                    Close
                  </button>
                </div>

              </div>
            </div>

            <!-- ISSUE DETAIL MODAL (nested) -->
            <t t-if="state.issueModalOpen">
              <div class="modal d-block" tabindex="-1">
                <div class="modal-dialog modal-lg">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">
                        Issue
                        <t t-if="state.issueDetail and state.issueDetail.issue">
                          <t t-esc="state.issueDetail.issue.name"/>
                        </t>
                      </h5>
                      <!-- UPDATED CLOSE BUTTON -->
                      <button type="button"
                              class="close"
                              aria-label="Close"
                              t-on-click="closeIssueModal">
                        <span aria-hidden="true">×</span>
                      </button>
                    </div>
                    <div class="modal-body">
                      <t t-if="!state.issueDetail">
                        <div>Loading…</div>
                      </t>
                      <t t-else="">
                        <div class="mb-3">
                          <strong>Driver: </strong>
                          <t t-esc="state.issueDetail.issue.driver.name"/>
                          <span class="mx-2">•</span>
                          <strong>Phone: </strong>
                          <t t-esc="state.issueDetail.issue.driver.phone"/>
                        </div>
                        <div class="mb-3">
                          <strong>Type: </strong>
                          <t t-esc="state.issueDetail.issue.issue_type"/>
                          <br/>
                          <strong>Category: </strong>
                          <t t-esc="state.issueDetail.issue.main_category"/>
                          <t t-if="state.issueDetail.issue.sub_category">
                            <span class="mx-1">›</span>
                            <t t-esc="state.issueDetail.issue.sub_category"/>
                          </t>
                          <t t-if="state.issueDetail.issue.sub_sub_category">
                            <span class="mx-1">›</span>
                            <t t-esc="state.issueDetail.issue.sub_sub_category"/>
                          </t>
                          <br/>
                          <strong>Status: </strong>
                          <t t-esc="state.issueDetail.issue.status_label"/>
                        </div>
                        <div class="mb-3">
                        <strong>Reporter Note (translated):</strong>
                        <div style="white-space: pre-wrap;">
                            <!-- fall back to original note if no translation yet -->
                            <t t-esc="state.issueDetail.issue.translated_note or state.issueDetail.issue.note"/>
                        </div>
                        </div>

                        <t t-if="state.issueDetail.issue.note">
                        <div class="mb-3">
                            <strong>Original Reporter Note:</strong>
                            <div style="white-space: pre-wrap;">
                            <t t-esc="state.issueDetail.issue.note"/>
                            </div>
                        </div>
                        </t>

                        <h6>Call Notes</h6>
                        <div class="table-responsive">
                          <table class="table table-sm">
                            <thead>
                              <tr>
                                <th>Date</th>
                                <th>Author</th>
                                <th>Status Change</th>
                                <th>Note</th>
                              </tr>
                            </thead>
                            <tbody>
                              <t t-if="!state.issueDetail.call_notes || !state.issueDetail.call_notes.length">
                                <tr><td colspan="4"><em>No call notes.</em></td></tr>
                              </t>
                              <t t-else="">
                                <t t-foreach="state.issueDetail.call_notes" t-as="cn" t-key="cn.id">
                                  <tr>
                                    <td style="white-space: nowrap;">
                                      <t t-esc="cn.created_at"/>
                                    </td>
                                    <td style="white-space: nowrap;">
                                      <t t-esc="cn.author"/>
                                    </td>
                                    <td style="white-space: nowrap;">
                                      <t t-esc="cn.status_from_label"/> →
                                      <t t-esc="cn.status_to_label"/>
                                    </td>
                                    <td style="white-space: pre-wrap;">
                                      <t t-esc="cn.note"/>
                                    </td>
                                  </tr>
                                </t>
                              </t>
                            </tbody>
                          </table>
                        </div>
                      </t>
                    </div>
                  </div>
                </div>
              </div>
            </t>

            <!-- STATUS CHANGE MODAL (nested) -->
            <t t-if="state.statusModalOpen">
              <div class="modal d-block" tabindex="-1">
                <div class="modal-dialog">
                  <div class="modal-content">
                    <div class="modal-header">
                      <h5 class="modal-title">Update Issue Status</h5>
                      <!-- UPDATED CLOSE BUTTON -->
                      <button type="button"
                              class="close"
                              aria-label="Close"
                              t-on-click="closeStatusModal">
                        <span aria-hidden="true">×</span>
                      </button>
                    </div>
                    <div class="modal-body">
                      <div class="mb-2">
                        <strong>Current status: </strong>
                        <t t-esc="state.statusModal.current_status_label"/>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">New status</label>
                        <select class="form-select" t-on-change="onStatusChange">
                          <t t-foreach="state.statusOptions" t-as="st" t-key="st.key">
                            <option t-att-value="st.key"
                                    t-att-selected="st.key === state.statusModal.new_status">
                              <t t-esc="st.label"/>
                            </option>
                          </t>
                        </select>
                      </div>
                      <div class="mb-3">
                        <label class="form-label">Call note (required)</label>
                        <textarea class="form-control" rows="3"
                                  placeholder="Describe the outcome of the call…"
                                  t-on-input="onStatusNote">
                          <t t-esc="state.statusModal.note"/>
                        </textarea>
                      </div>
                    </div>
                    <div class="modal-footer">
                      <button type="button" class="btn btn-secondary"
                              t-on-click="closeStatusModal">
                        Cancel
                      </button>
                      <button type="button" class="btn btn-primary"
                              t-on-click="submitStatusChange">
                        Save
                      </button>
                    </div>
                  </div>
                </div>
              </div>
            </t>

          </div>
        </t>

      </t>
    </div>
  </t>
</templates>
