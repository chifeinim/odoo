                    </t>
                    <t t-else="">
                      <span class="text-success">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Average Utilisation %
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Utilisation</h5>
