                  </p>
                </div>
              </div>
            </div> -->
            <!-- Average Efficiency %
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Efficiency</h5>
                  <h2><t t-esc="formatNumber(state.metrics.avgEfficiency, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevAvgEfficiency"/>
                    <t t-set="curr"  t-value="state.metrics.avgEfficiency"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
