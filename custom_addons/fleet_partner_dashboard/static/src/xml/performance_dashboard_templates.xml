<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlPerformanceDashboard" owl="1">
    <div
      t-key="'owl_performance_dashboard_root'"
      class="o_fleet_dashboard"
      style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;"
    >
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">
        <h1 class="mb-4">Performance Dashboard</h1>

        <!-- FILTER BAR & TOGGLE -->
        <div class="mb-4 p-3 bg-light rounded d-flex align-items-center gap-2">
          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.selectedProducts.length">
                (<t t-esc="state.selectedProducts.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showProducts}"
                 style="max-height:200px;overflow:auto">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Quality -->
          <div class="dropdown" t-att-class="{'show': state.showScores}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showScores')">
              Driver Quality
              <t t-if="state.selectedScores.length">
                (<t t-esc="state.selectedScores.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showScores}">
              <t t-foreach="state.qualityScores" t-as="sc" t-key="sc.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedScores.includes(sc.key)}"
                        t-on-click="() => toggleFilter('selectedScores', sc.key)">
                  <t t-esc="sc.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown" t-att-class="{'show': state.showCategories}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showCategories')">
              Driver Category
              <t t-if="state.selectedCategories.length">
                (<t t-esc="state.selectedCategories.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showCategories}">
              <t t-foreach="state.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Time Period -->
          <div class="dropdown" t-att-class="{'show': state.showPeriod}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showPeriod')">
              <t t-esc="state.selectedPeriod"/>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showPeriod}">
              <t t-foreach="state.timePeriods" t-as="pw" t-key="pw">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedPeriod === pw}"
                        t-on-click="() => changePeriod(pw)">
                  <t t-esc="pw"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Explicit Dates -->
          <div class="d-flex align-items-center gap-1">
            <label class="mb-0">From:</label>
            <input type="date" class="form-control"
                   t-att-value="state.startDate"
                   t-on-change="onStartDateChange"/>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="mb-0">To:</label>
            <input type="date" class="form-control"
                   t-att-value="state.endDate"
                   t-on-change="onEndDateChange"/>
          </div>

          <!-- Toggle Cards/Charts -->
          <button class="btn btn-primary ms-auto"
                  t-on-click="toggleView">
            <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
          </button>
        </div>

        <!-- KPI CARDS: always 3 per row -->
        <t t-if="!state.showCharts">
          <!-- first row: Active, Trips, Supply -->
          <div class="row mb-4">
            <!-- Active Drivers -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Active Drivers</h5>
                  <h2><t t-esc="formatNumber(state.metrics.activeDrivers, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevActiveDrivers"/>
                    <t t-set="curr"  t-value="state.metrics.activeDrivers"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Total Trips -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Total Trips</h5>
                  <h2><t t-esc="formatNumber(state.metrics.tripCount, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripCount"/>
                    <t t-set="curr"  t-value="state.metrics.tripCount"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
