        <!-- SEARCH + TABLE -->
        <div class="form-group mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="Search name or phone..."
                 t-att-value="state.search"
                 t-on-input="onSearchChange"/>
        </div>
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th style="cursor:pointer" t-on-click="() => setSort('name')">
                Driver
                <t t-if="state.sortKey === 'name'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('quality_score')">
                Quality Score
                <t t-if="state.sortKey === 'quality_score'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('phone')">
                Phone
                <t t-if="state.sortKey === 'phone'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('hire_date')">
                Hire Date
                <t t-if="state.sortKey === 'hire_date'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('product_type')">
                Product
                <t t-if="state.sortKey === 'product_type'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('type')">
                Category
                <t t-if="state.sortKey === 'type'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('cash')">
                GMV (Kz)
                <t t-if="state.sortKey === 'cash'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('trips')">
                Trips
                <t t-if="state.sortKey === 'trips'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('hours')">
                Supply Hours
                <t t-if="state.sortKey === 'hours'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('trips_per_hour')">
                Trips/Hour
                <t t-if="state.sortKey === 'trips_per_hour'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('money_per_hour')">
                Money/Hour
                <t t-if="state.sortKey === 'money_per_hour'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <!--
              <th style="cursor:pointer" t-on-click="() => setSort('utilisation')">
                Utilisation
                <t t-if="state.sortKey === 'utilisation'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('efficiency')">
                Efficiency
                <t t-if="state.sortKey === 'efficiency'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              -->
              <th style="cursor:pointer" t-on-click="() => setSort('acceptance_rate')">
                Acceptance Rate
                <t t-if="state.sortKey === 'acceptance_rate'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('cancelled_by_driver')">
                Cancelled by Driver
                <t t-if="state.sortKey === 'cancelled_by_driver'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('completed_to_request')">
                Completed to Request
                <t t-if="state.sortKey === 'completed_to_request'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('completion_rate')">
                Completion Rate
                <t t-if="state.sortKey === 'completion_rate'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <!--
              <th style="cursor:pointer" t-on-click="() => setSort('service_fee')">
                Service Fee Kz
                <t t-if="state.sortKey === 'service_fee'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              <th style="cursor:pointer" t-on-click="() => setSort('partner_fee')">
                Partner Fee Kz
                <t t-if="state.sortKey === 'partner_fee'"><span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/></t>
              </th>
              -->
            </tr>
          </thead>
          <tbody>
            <t t-foreach="pagedDrivers()" t-as="d" t-key="d.id">
              <tr>
                <td><t t-esc="d.name"/></td>
                <td t-att-style="qualityBgStyle(d.quality_score)"><t t-esc="d.quality_score"/></td>
                <td><t t-esc="d.phone"/></td>
                <td><t t-esc="d.hire_date"/></td>
                <td><t t-esc="d.product_type"/></td>
                <td><t t-esc="d.type"/></td>
                <td><t t-esc="formatNumber(d.cash, 0)"/></td>
                <td><t t-esc="formatNumber(d.trips, 0)"/></td>
                <td><t t-esc="formatNumber(d.hours, 0)"/>h</td>
                <td><t t-esc="formatNumber(d.trips_per_hour, 0)"/></td>
                <td><t t-esc="formatNumber(d.money_per_hour, 0)"/></td>
                <!--
                <td><t t-esc="formatNumber(d.utilisation, 1)"/>%</td>
                <td><t t-esc="formatNumber(d.efficiency, 1)"/>%</td>
                -->
                <td><t t-esc="formatNumber(d.acceptance_rate, 1)"/>%</td>
                <td><t t-esc="formatNumber(d.cancelled_by_driver, 1)"/>%</td>
                <td><t t-esc="formatNumber(d.completed_to_request, 1)"/>%</td>
                <td><t t-esc="formatNumber(d.completion_rate, 1)"/>%</td>
                <!--
                <td><t t-esc="formatNumber(d.service_fee, 0)"/></td>
                <td><t t-esc="formatNumber(d.partner_fee, 0)"/></td>
                -->
              </tr>
            </t>
          </tbody>
        </table>

        <!-- Pagination -->
        <div class="d-flex align-items-center justify-content-between py-2">
          <div>
            <t t-set="total" t-value="totalDriverCount()"/>
            <t t-set="start" t-value="Math.min(total, ((state.page-1)*state.pageSize)+1)"/>
            <t t-set="end"   t-value="Math.min(total, (state.page*state.pageSize))"/>
            <small class="text-muted">
              Showing <t t-esc="start"/>–<t t-esc="end"/> of <t t-esc="total"/>
            </small>
          </div>
          <div class="btn-group">
            <!-- First/Prev use outline so the active page stands out -->
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page === 1"
                    t-on-click="() => goToPage(1)">« First</button>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page === 1"
                    t-on-click="prevPage">‹ Prev</button>

            <!-- Numbered page buttons -->
            <t t-foreach="pageWindow()" t-as="pg" t-key="pg">
              <t t-if="pg === '…'">
                <button class="btn btn-outline-primary" disabled="disabled">…</button>
              </t>
              <t t-elif="state.page === pg">
                <!-- ACTIVE page: solid blue, disabled, aria-current -->
                <button class="btn btn-primary active"
                        disabled="disabled"
                        aria-current="page">
                  <t t-esc="pg"/>
                </button>
              </t>
              <t t-else="">
                <!-- Other pages: outline blue -->
                <button class="btn btn-outline-primary"
                        t-on-click="() => goToPage(pg)"
                        t-att-aria-label="'Go to page ' + pg">
                  <t t-esc="pg"/>
                </button>
              </t>
            </t>

            <!-- Next/Last use outline too -->
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="nextPage">Next ›</button>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="() => goToPage(pageCount())">Last »</button>
          </div>
        </div>
      </t>
    </div>
  </t>
</templates>
