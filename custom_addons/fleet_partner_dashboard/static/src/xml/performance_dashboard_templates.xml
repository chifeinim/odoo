<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlPerformanceDashboard" owl="1">
    <div
      t-key="'owl_performance_dashboard_root'"
      class="o_fleet_dashboard"
      style="padding: 1rem;"
    >
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">
        <h1 class="mb-4">Performance Dashboard</h1>

        <!-- FILTER BAR & TOGGLE -->
        <div t-ref="filtersBar"
          class="mb-3 p-3 rounded d-flex align-items-center gap-2 flex-wrap sticky-filters bg-light">
          <div class="mb-4 p-3 bg-light rounded d-flex align-items-center gap-2">
            <!-- Anda Product -->
            <div class="dropdown" t-att-class="{'show': state.showProducts}">
              <button class="btn btn-primary dropdown-toggle"
                      type="button"
                      t-on-click="() => toggleDropdown('showProducts')">
                Anda Product
                <t t-if="state.draftSelectedProducts.length">
                  (<t t-esc="state.draftSelectedProducts.length"/>)
                </t>
              </button>
              <div class="dropdown-menu"
                  t-att-class="{'show': state.showProducts}"
                  style="max-height:200px;overflow:auto">
                <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                  <button class="dropdown-item"
                      t-att-class="{'active': state.draftSelectedProducts.includes(pt.id)}"
                      t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                    <t t-esc="pt.name"/>
                  </button>
                </t>
              </div>
            </div>

            <!-- Driver Quality -->
            <div class="dropdown" t-att-class="{'show': state.showScores}">
              <button class="btn btn-primary dropdown-toggle"
                      type="button"
                      t-on-click="() => toggleDropdown('showScores')">
                Driver Quality
                <t t-if="state.draftSelectedScores.length">
                  (<t t-esc="state.draftSelectedScores.length"/>)
                </t>
              </button>
              <div class="dropdown-menu" t-att-class="{'show': state.showScores}">
                <t t-foreach="state.qualityScores" t-as="sc" t-key="sc.key">
                  <button class="dropdown-item"
                          t-att-class="{'active': state.draftSelectedScores.includes(sc.key)}"
                          t-on-click="() => toggleFilter('selectedScores', sc.key)">
                    <t t-esc="sc.label"/>
                  </button>
                </t>
              </div>
            </div>

            <!-- Driver Category -->
            <div class="dropdown" t-att-class="{'show': state.showCategories}">
              <button class="btn btn-primary dropdown-toggle"
                      type="button"
                      t-on-click="() => toggleDropdown('showCategories')">
                Driver Category
                <t t-if="state.draftSelectedCategories.length">
                  (<t t-esc="state.draftSelectedCategories.length"/>)
                </t>
              </button>
              <div class="dropdown-menu" t-att-class="{'show': state.showCategories}">
                <t t-foreach="state.categories" t-as="ct" t-key="ct">
                  <button class="dropdown-item"
                          t-att-class="{'active': state.draftSelectedCategories.includes(ct)}"
                          t-on-click="() => toggleFilter('selectedCategories', ct)">
                    <t t-esc="ct"/>
                  </button>
                </t>
              </div>
            </div>

            <!-- Time Period -->
            <div class="dropdown" t-att-class="{'show': state.showPeriod}">
              <button class="btn btn-primary dropdown-toggle"
                      type="button"
                      t-on-click="() => toggleDropdown('showPeriod')">
                <t t-esc="state.draftSelectedPeriod"/>
              </button>
              <div class="dropdown-menu" t-att-class="{'show': state.showPeriod}">
                <t t-foreach="state.timePeriods" t-as="pw" t-key="pw">
                  <button class="dropdown-item"
                          t-att-class="{'active': state.draftSelectedPeriod === pw}"
                          t-on-click="() => changePeriod(pw)">
                    <t t-esc="pw"/>
                  </button>
                </t>
              </div>
            </div>

            <!-- Explicit Dates -->
            <div class="d-flex align-items-center gap-1">
              <label class="mb-0">From:</label>
              <input type="date" class="form-control"
                    t-att-value="state.draftStartDate"
                    t-on-change="onStartDateChange"/>
            </div>
            <div class="d-flex align-items-center gap-1">
              <label class="mb-0">To:</label>
              <input type="date" class="form-control"
                    t-att-value="state.draftEndDate"
                    t-on-change="onEndDateChange"/>
            </div>

            <!-- Apply Filters -->
            <button class="btn btn-primary"
                    t-att-disabled="!isDirty()"
                    t-on-click="applyFilters">
              Apply Filters
            </button>

            <!-- Toggle Cards/Charts -->
            <button class="btn btn-primary ms-auto"
                    t-on-click="toggleView">
              <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
            </button>
          </div>
        </div>

        <!-- SEARCH -->
        <div t-ref="searchBar" class="mb-3 sticky-search">
          <input type="text"
                 class="form-control"
                 placeholder="Search name or phone..."
                 t-att-value="state.search"
                 t-on-input="onSearchChange"/>
        </div>

        <!-- KPI CARDS -->
        <t t-if="!state.showCharts">

          <!-- Row 1: Active Drivers / Total Trips / Supply Hours -->
          <div class="row mb-4">
            <!-- Active Drivers -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Active Drivers</h5>
                  <h2><t t-esc="formatNumber(state.metrics.activeDrivers, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevActiveDrivers"/>
                    <t t-set="curr"  t-value="state.metrics.activeDrivers"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Total Trips -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Total Trips</h5>
                  <h2><t t-esc="formatNumber(state.metrics.tripCount, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripCount"/>
                    <t t-set="curr"  t-value="state.metrics.tripCount"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Supply Hours -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Supply Hours</h5>
                  <h2><t t-esc="formatNumber(state.metrics.supplyHours, 0)"/>h</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevSupplyHours"/>
                    <t t-set="curr"  t-value="state.metrics.supplyHours"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 2: Gross Revenue / Revenue / Hour / Trips / Hour -->
          <div class="row mb-4">
            <!-- Gross Revenue -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Gross Revenue</h5>
                  <h2>Kz <t t-esc="formatNumber(state.metrics.cashEarned, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCashEarned"/>
                    <t t-set="curr"  t-value="state.metrics.cashEarned"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Revenue / Hour -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Revenue / Hour</h5>
                  <h2>Kz <t t-esc="formatNumber(state.metrics.moneyPerHour, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevMoneyPerHour"/>
                    <t t-set="curr"  t-value="state.metrics.moneyPerHour"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Trips / Hour -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Trips / Hour</h5>
                  <h2><t t-esc="formatNumber(state.metrics.tripsPerHour, 2)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripsPerHour"/>
                    <t t-set="curr"  t-value="state.metrics.tripsPerHour"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 3: SH per Active Driver / Trips per Active Driver / Acceptance Rate -->
          <div class="row mb-4">
            <!-- SH per Active Driver -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">SH per Active Driver</h5>
                  <h2><t t-esc="formatNumber(state.metrics.avgSupplyHoursPerDriver, 1)"/>h</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevAvgSupplyHoursPerDriver"/>
                    <t t-set="curr"  t-value="state.metrics.avgSupplyHoursPerDriver"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Trips per Active Driver -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Trips per Active Driver</h5>
                  <h2><t t-esc="formatNumber(state.metrics.tripsPerActiveDriver, 2)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripsPerActiveDriver"/>
                    <t t-set="curr"  t-value="state.metrics.tripsPerActiveDriver"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Acceptance Rate -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Acceptance Rate</h5>
                  <h2><t t-esc="formatNumber(state.metrics.acceptanceRate, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev" t-value="state.metrics.prevAcceptanceRate"/>
                    <t t-set="curr" t-value="state.metrics.acceptanceRate"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 4: Cancelled by Driver / Cancelled by Customer / Cancelled due to Network -->
          <div class="row mb-4">
            <!-- Cancelled by Driver % -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Cancelled by Driver</h5>
                  <h2><t t-esc="formatNumber(state.metrics.cancelledByDriverPct, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCancelledByDriverPct"/>
                    <t t-set="curr"  t-value="state.metrics.cancelledByDriverPct"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-danger">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-success">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Cancelled by Customer % -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Cancelled by Customer</h5>
                  <h2><t t-esc="formatNumber(state.metrics.cancelledByCustomerPct, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCancelledByCustomerPct"/>
                    <t t-set="curr"  t-value="state.metrics.cancelledByCustomerPct"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-danger">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-success">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Cancelled due to Network % -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Cancelled due to Network</h5>
                  <h2><t t-esc="formatNumber(state.metrics.cancelledDueToNetworkPct, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCancelledDueToNetworkPct"/>
                    <t t-set="curr"  t-value="state.metrics.cancelledDueToNetworkPct"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-danger">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-success">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 5: Completed to Request / Completion Rate / Service Fee -->
          <div class="row mb-4">
            <!-- Completed to Request % -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Completed to Request</h5>
                  <h2><t t-esc="formatNumber(state.metrics.completedToRequest, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev" t-value="state.metrics.prevCompletedToRequest"/>
                    <t t-set="curr" t-value="state.metrics.completedToRequest"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Completion Rate %-->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Completion Rate</h5>
                  <h2><t t-esc="formatNumber(state.metrics.completionRate, 1)"/>%</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCompletionRate"/>
                    <t t-set="curr"  t-value="state.metrics.completionRate"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    from last period
                  </p>
                </div>
              </div>
            </div>

            <!-- Service Fee -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Service Fee</h5>
                  <h2>Kz <t t-esc="formatNumber(state.metrics.serviceFee, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevServiceFee"/>
                    <t t-set="curr"  t-value="state.metrics.serviceFee"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

          <!-- Row 6: Partner Fee -->
          <div class="row mb-4">
            <!-- Partner Fee -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Partner Fee</h5>
                  <h2>Kz <t t-esc="formatNumber(state.metrics.partnerFee, 0)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevPartnerFee"/>
                    <t t-set="curr"  t-value="state.metrics.partnerFee"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>

        </t>

        <!-- LINE CHARTS -->
        <t t-if="state.showCharts">
          <div class="row g-1 mb-1">

            <!-- Row 1 -->
            <div class="col-md-4">
              <canvas t-ref="chartActive" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartTrips" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartSupply" style="height:200px"></canvas>
            </div>

            <!-- Row 2 -->
            <div class="col-md-4">
              <canvas t-ref="chartCash" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartMoneyPerHour" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartTripsPerHour" style="height:200px"></canvas>
            </div>

            <!-- Row 3 -->
            <div class="col-md-4">
              <canvas t-ref="chartAvgSupply" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartTripsPerActiveDriver" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartAcceptance" style="height:200px"></canvas>
            </div>

            <!-- Row 4 -->
            <div class="col-md-4">
              <canvas t-ref="chartCancelledByDriver" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartCancelledByCustomer" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartCancelledDueToNetwork" style="height:200px"></canvas>
            </div>

            <!-- Row 5 -->
            <div class="col-md-4">
              <canvas t-ref="chartCompletedToRequest" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartCompletionRate" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartServiceFee" style="height:200px"></canvas>
            </div>

            <!-- Row 6 -->
            <div class="col-md-4">
              <canvas t-ref="chartPartnerFee" style="height:200px"></canvas>
            </div>

            <!-- Distribution pies (kept after the KPI-style charts) -->
            <div class="col-md-4">
              <canvas t-ref="chartQuality" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartProduct" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartCategory" style="height:200px"></canvas>
            </div>

            <!-- Optional historic utilisation / efficiency: keeping commented -->
            <!--
            <div class="col-md-4">
              <canvas t-ref="chartUtilisation" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartEfficiency" style="height:200px"></canvas>
            </div>
            -->
          </div>
        </t>


        <!-- STICKY CLONE HOST -->
        <div t-ref="stickyHeader" class="fp-sticky-header fp-hidden"></div>

        <!-- TABLE -->
        <div class="table-responsive" t-ref="tableWrap">
          <table class="table table-striped table-hover mb-0" t-ref="driversTable">
            <thead class="table-light sticky-thead">
              <tr>
                <th data-sort-key="name" style="cursor:pointer" t-on-click="() => setSort('name')">
                  Driver
                  <t t-if="state.sortKey === 'name'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="quality_score" style="cursor:pointer" t-on-click="() => setSort('quality_score')">
                  Quality Score
                  <t t-if="state.sortKey === 'quality_score'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="phone" style="cursor:pointer" t-on-click="() => setSort('phone')">
                  Phone
                  <t t-if="state.sortKey === 'phone'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="hire_date" style="cursor:pointer" t-on-click="() => setSort('hire_date')">
                  Hire Date
                  <t t-if="state.sortKey === 'hire_date'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="product_type" style="cursor:pointer" t-on-click="() => setSort('product_type')">
                  Product
                  <t t-if="state.sortKey === 'product_type'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="type" style="cursor:pointer" t-on-click="() => setSort('type')">
                  Category
                  <t t-if="state.sortKey === 'type'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="cash" style="cursor:pointer" t-on-click="() => setSort('cash')">
                  GMV (Kz)
                  <t t-if="state.sortKey === 'cash'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="trips" style="cursor:pointer" t-on-click="() => setSort('trips')">
                  Trips
                  <t t-if="state.sortKey === 'trips'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="hours" style="cursor:pointer" t-on-click="() => setSort('hours')">
                  Supply Hours
                  <t t-if="state.sortKey === 'hours'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="trips_per_hour" style="cursor:pointer" t-on-click="() => setSort('trips_per_hour')">
                  Trips/Hour
                  <t t-if="state.sortKey === 'trips_per_hour'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="money_per_hour" style="cursor:pointer" t-on-click="() => setSort('money_per_hour')">
                  Money/Hour
                  <t t-if="state.sortKey === 'money_per_hour'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="acceptance_rate" style="cursor:pointer" t-on-click="() => setSort('acceptance_rate')">
                  Acceptance Rate
                  <t t-if="state.sortKey === 'acceptance_rate'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="cancelled_by_driver" style="cursor:pointer" t-on-click="() => setSort('cancelled_by_driver')">
                  Cancelled by Driver
                  <t t-if="state.sortKey === 'cancelled_by_driver'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="completed_to_request" style="cursor:pointer" t-on-click="() => setSort('completed_to_request')">
                  Completed to Request
                  <t t-if="state.sortKey === 'completed_to_request'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>

                <th data-sort-key="completion_rate" style="cursor:pointer" t-on-click="() => setSort('completion_rate')">
                  Completion Rate
                  <t t-if="state.sortKey === 'completion_rate'">
                    <span class="ms-1" t-esc="state.sortDir === 'asc' ? '▲' : '▼'"/>
                  </t>
                </th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="pagedDrivers()" t-as="d" t-key="d.id">
                <tr>
                  <td>
                    <a href="#" t-on-click="() => openDriver(d)">
                      <t t-esc="d.name"/>
                    </a>
                  </td>
                  <td t-att-style="qualityBgStyle(d.quality_score)">
                    <t t-esc="d.quality_score"/>
                  </td>
                  <td><t t-esc="d.phone"/></td>
                  <td><t t-esc="d.hire_date"/></td>
                  <td><t t-esc="d.product_type"/></td>
                  <td><t t-esc="d.type"/></td>
                  <td><t t-esc="formatNumber(d.cash, 0)"/></td>
                  <td><t t-esc="formatNumber(d.trips, 0)"/></td>
                  <td><t t-esc="formatNumber(d.hours, 0)"/>h</td>
                  <td><t t-esc="formatNumber(d.trips_per_hour, 0)"/></td>
                  <td><t t-esc="formatNumber(d.money_per_hour, 0)"/></td>
                  <td><t t-esc="formatNumber(d.acceptance_rate, 1)"/>%</td>
                  <td><t t-esc="formatNumber(d.cancelled_by_driver, 1)"/>%</td>
                  <td><t t-esc="formatNumber(d.completed_to_request, 1)"/>%</td>
                  <td><t t-esc="formatNumber(d.completion_rate, 1)"/>%</td>
                </tr>
              </t>
            </tbody>
          </table>
        </div>

        <!-- Pagination -->
        <div class="d-flex align-items-center justify-content-between py-2">
          <div>
            <t t-set="total" t-value="totalDriverCount()"/>
            <t t-set="start" t-value="Math.min(total, ((state.page-1)*state.pageSize)+1)"/>
            <t t-set="end"   t-value="Math.min(total, (state.page*state.pageSize))"/>
            <small class="text-muted">
              Showing <t t-esc="start"/>–<t t-esc="end"/> of <t t-esc="total"/>
            </small>
          </div>
          <div class="btn-group">
            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page === 1"
                    t-on-click="() => goToPage(1)">« First</button>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page === 1"
                    t-on-click="prevPage">‹ Prev</button>

            <t t-foreach="pageWindow()" t-as="pg" t-key="pg">
              <t t-if="pg === '…'">
                <button class="btn btn-outline-primary" disabled="disabled">…</button>
              </t>
              <t t-elif="state.page === pg">
                <button class="btn btn-primary active"
                        disabled="disabled"
                        aria-current="page">
                  <t t-esc="pg"/>
                </button>
              </t>
              <t t-else="">
                <button class="btn btn-outline-primary"
                        t-on-click="() => goToPage(pg)"
                        t-att-aria-label="'Go to page ' + pg">
                  <t t-esc="pg"/>
                </button>
              </t>
            </t>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="nextPage">Next ›</button>

            <button class="btn btn-outline-primary"
                    t-att-disabled="state.page >= pageCount()"
                    t-on-click="() => goToPage(pageCount())">Last »</button>
          </div>
        </div>

        <!-- MODAL (Driver Details) -->
        <t t-if="state.showModal">
          <div class="modal d-block"
               tabindex="-1"
               t-ref="perf_modal"
               style="background:rgba(0,0,0,0.4)">
            <div class="modal-dialog modal-xl" style="max-width: 80vw;">
              <div class="modal-content">
                <div class="modal-header">
                  <h5 class="modal-title">Driver Details</h5>
                </div>

                <div class="modal-body">
                  <div class="row">
                    <!-- LEFT: identity (no Risk line here) -->
                    <div class="col-md-3">
                      <div><strong>Name:</strong> <t t-esc="state.modalDriver.name"/></div>
                      <div><strong>Phone:</strong> <t t-esc="state.modalDriver.phone"/></div>
                      <div><strong>Product:</strong> <t t-esc="state.modalDriver.product_type"/></div>
                      <div><strong>Hire Date:</strong> <t t-esc="state.modalDriver.hire_date"/></div>
                      <div><strong>Driver Quality:</strong> <t t-esc="state.modalDriver.quality_score"/></div>
                    </div>

                    <!-- RIGHT SIDE: cards or charts -->
                    <div class="col-md-9">
                      <div class="d-flex justify-content-end mb-2">
                        <button class="btn btn-primary"
                                t-on-click="toggleModalView">
                          <t t-esc="state.modalShowCharts ? 'Show Cards' : 'Show Charts'"/>
                        </button>
                      </div>

                      <t t-if="!state.modalShowCharts">
                        <!-- KPI cards for this driver -->
                        <div class="row g-3">
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Gross Revenue</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.cash || 0, 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.trips || 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Hours Online</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.hours || 0, 0)"/>
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Acceptance %</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.acceptance_rate || 0, 1)"/>%
                                </h3>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-4">
                            <div class="card">
                              <div class="card-body">
                                <h6>Completion %</h6>
                                <h3>
                                  <t t-esc="formatNumber(state.modalDriver.cards?.completion_rate || 0, 1)"/>%
                                </h3>
                              </div>
                            </div>
                          </div>
                        </div>
                      </t>
                      <t t-else="">
                        <!-- driver trend charts -->
                        <div class="row g-3">
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Gross Revenue</h6>
                                <canvas id="lp_chart_cash" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Trips</h6>
                                <canvas id="lp_chart_trips" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Hours Online</h6>
                                <canvas id="lp_chart_hours" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Acceptance Rate %</h6>
                                <canvas id="lp_chart_acc" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                          <div class="col-md-6">
                            <div class="card">
                              <div class="card-body">
                                <h6>Completion Rate %</h6>
                                <canvas id="lp_chart_comp" height="160"></canvas>
                              </div>
                            </div>
                          </div>
                        </div>
                      </t>
                    </div>
                  </div>

                  <!-- Issues list -->
                  <div class="mt-4">
                    <h6>Issues</h6>
                    <div class="table-responsive">
                      <table class="table table-sm">
                        <thead>
                          <tr>
                            <th>Category</th>
                            <th>Date Reported</th>
                            <th>Date Resolved</th>
                            <th>Reporter Note</th>
                          </tr>
                        </thead>
                        <tbody>
                          <t t-if="!state.modalDriver.issues || !state.modalDriver.issues.length">
                            <tr>
                              <td colspan="4"><em>No issues in this window.</em></td>
                            </tr>
                          </t>
                          <t t-else="">
                            <t t-foreach="state.modalDriver.issues"
                               t-as="it"
                               t-key="it.date_reported + it.category_path">
                              <tr style="vertical-align: top;">
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.category_path"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_reported"/>
                                </td>
                                <td style="white-space: nowrap;">
                                  <t t-esc="it.date_resolved or ''"/>
                                </td>
                                <td style="white-space: pre-wrap;">
                                  <t t-esc="it.note"/>
                                </td>
                              </tr>
                            </t>
                          </t>
                        </tbody>
                      </table>
                    </div>
                  </div>
                </div>

                <div class="modal-footer">
                  <button class="btn btn-secondary" t-on-click="closeModal">Close</button>
                </div>
              </div>
            </div>
          </div>
        </t>
      </t>
    </div>
  </t>
</templates>