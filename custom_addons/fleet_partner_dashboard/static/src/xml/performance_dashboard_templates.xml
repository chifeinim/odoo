<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlPerformanceDashboard" owl="1">
    <div
      t-key="'owl_performance_dashboard_root'"
      class="o_fleet_dashboard"
      style="height: calc(100vh - 70px); overflow-y: auto; padding: 1rem;"
    >
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">
        <h1 class="mb-4">Performance Dashboard</h1>

        <!-- FILTER BAR & TOGGLE -->
        <div class="mb-4 p-3 bg-light rounded d-flex align-items-center gap-2">
          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.selectedProducts.length">
                (<t t-esc="state.selectedProducts.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showProducts}"
                 style="max-height:200px;overflow:auto">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Quality -->
          <div class="dropdown" t-att-class="{'show': state.showScores}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showScores')">
              Driver Quality
              <t t-if="state.selectedScores.length">
                (<t t-esc="state.selectedScores.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showScores}">
              <t t-foreach="state.qualityScores" t-as="sc" t-key="sc.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedScores.includes(sc.key)}"
                        t-on-click="() => toggleFilter('selectedScores', sc.key)">
                  <t t-esc="sc.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown" t-att-class="{'show': state.showCategories}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showCategories')">
              Driver Category
              <t t-if="state.selectedCategories.length">
                (<t t-esc="state.selectedCategories.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showCategories}">
              <t t-foreach="state.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Time Period -->
          <div class="dropdown" t-att-class="{'show': state.showPeriod}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showPeriod')">
              <t t-esc="state.selectedPeriod"/>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showPeriod}">
              <t t-foreach="state.timePeriods" t-as="pw" t-key="pw">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedPeriod === pw}"
                        t-on-click="() => changePeriod(pw)">
                  <t t-esc="pw"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Explicit Dates -->
          <div class="d-flex align-items-center gap-1">
            <label class="mb-0">From:</label>
            <input type="date" class="form-control"
                   t-att-value="state.startDate"
                   t-on-change="onStartDateChange"/>
          </div>
          <div class="d-flex align-items-center gap-1">
            <label class="mb-0">To:</label>
            <input type="date" class="form-control"
                   t-att-value="state.endDate"
                   t-on-change="onEndDateChange"/>
          </div>

          <!-- Toggle Cards/Charts -->
          <button class="btn btn-primary ms-auto"
                  t-on-click="toggleView">
            <t t-esc="state.showCharts ? 'Show Cards' : 'Show Charts'"/>
          </button>
        </div>

        <!-- KPI CARDS: always 3 per row -->
        <t t-if="!state.showCharts">
          <!-- first row: Active, Trips, Supply -->
          <div class="row mb-4">
            <!-- Active Drivers -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Active Drivers</h5>
                  <h2><t t-esc="state.metrics.activeDrivers"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevActiveDrivers"/>
                    <t t-set="curr"  t-value="state.metrics.activeDrivers"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Total Trips -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Total Trips</h5>
                  <h2><t t-esc="state.metrics.tripCount"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripCount"/>
                    <t t-set="curr"  t-value="state.metrics.tripCount"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Supply Hours -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Supply Hours</h5>
                  <h2><t t-esc="state.metrics.supplyHours.toFixed(1)"/>h</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevSupplyHours"/>
                    <t t-set="curr"  t-value="state.metrics.supplyHours"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>
          <!-- second row: Total Cash Earned -->
          <div class="row mb-4">
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Cash Earned</h5>
                  <h2>Kz <t t-esc="state.metrics.cashEarned.toFixed(2)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevCashEarned"/>
                    <t t-set="curr"  t-value="state.metrics.cashEarned"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">
                        &#9650; <t t-esc="delta.toFixed(1)"/>%
                      </span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">
                        &#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%
                      </span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Avg Money per Hour card -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Avg Money / Hour</h5>
                  <h2>Kz <t t-esc="state.metrics.moneyPerHour.toFixed(2)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevMoneyPerHour"/>
                    <t t-set="curr"  t-value="state.metrics.moneyPerHour"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
            <!-- Avg Trips/hr -->
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Avg Trips / Hour</h5>
                  <h2><t t-esc="state.metrics.tripsPerHour.toFixed(2)"/></h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevTripsPerHour"/>
                    <t t-set="curr"  t-value="state.metrics.tripsPerHour"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                    &#160;from last period
                  </p>
                </div>
              </div>
            </div>
          </div>
          <!-- third row: Avg Supply Hours per Active Driver -->
          <div class="row mb-4">
            <div class="col-md-4 mb-3">
              <div class="card text-center h-100">
                <div class="card-body">
                  <h5 class="card-title">Avg SH per Active Driver</h5>
                  <h2><t t-esc="state.metrics.avgSupplyHoursPerDriver.toFixed(1)"/>h</h2>
                  <p class="card-text">
                    <t t-set="prev"  t-value="state.metrics.prevAvgSupplyHoursPerDriver"/>
                    <t t-set="curr"  t-value="state.metrics.avgSupplyHoursPerDriver"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
                      <span class="text-success">&#9650; <t t-esc="delta.toFixed(1)"/>%</span>
                    </t>
                    <t t-else="">
                      <span class="text-danger">&#9660; <t t-esc="Math.abs(delta).toFixed(1)"/>%</span>
                    </t>
                     from last period
                  </p>
                </div>
              </div>
            </div>
          </div>          

        </t>

        <!-- LINE CHARTS -->
        <t t-if="state.showCharts">
          <div class="row mb-4">
            <div class="col-md-4">
              <canvas t-ref="chartActive" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartTrips"  style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartSupply" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartCash"   style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartMoneyPerHour" style="height:200px"></canvas>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartTripsPerHour" style="height:200px"/>
            </div>
            <div class="col-md-4">
              <canvas t-ref="chartAvgSupply" style="height:200px"></canvas>
            </div>
          </div>
        </t>

        <!-- SEARCH + TABLE -->
        <div class="form-group mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="Search driver…"
                 t-model="state.search"/>
        </div>
        <table class="table table-striped table-hover mb-0">
          <thead class="table-light">
            <tr>
              <th>Driver</th><th>Phone</th><th>Hire Date</th>
              <th>Product</th><th>Category</th><th>Quality</th><th>Cash Kz</th><th>Trips</th>
              <th>Supply Hours</th><th>Completed to Request %</th><th>Trips/Hour</th>
              <th>Money/Hour</th><th>Utilisation %</th><th>Efficiency %</th>
              <th>Service Fee Kz</th><th>Partner Fee Kz</th>
            </tr>
          </thead>
          <tbody>
            <t t-foreach="
                Object.values(state.data)
                      .filter(d => d.name.toLowerCase().includes(state.search.toLowerCase()))
            " t-as="d" t-key="d.id">
              <tr>
                <td><t t-esc="d.name"/></td>
                <td><t t-esc="d.phone"/></td>
                <td><t t-esc="d.hire_date"/></td>
                <td><t t-esc="d.product_type"/></td>
                <td><t t-esc="d.type"/></td>
                <td><t t-esc="d.quality_score"/></td>
                <td><t t-esc="d.cash.toFixed(2)"/></td>
                <td><t t-esc="d.trips"/></td>
                <td><t t-esc="d.hours.toFixed(1)"/>h</td>
                <td><t t-esc="d.completed_to_request.toFixed(1)"/>%</td>
                <td><t t-esc="d.trips_per_hour.toFixed(2)"/></td>
                <td><t t-esc="d.money_per_hour.toFixed(2)"/></td>
                <td><t t-esc="d.utilisation.toFixed(1)"/>%</td>
                <td><t t-esc="d.efficiency.toFixed(1)"/>%</td>
                <td><t t-esc="d.service_fee.toFixed(2)"/></td>
                <td><t t-esc="d.partner_fee.toFixed(2)"/></td>
              </tr>
            </t>
          </tbody>
        </table>
      </t>
    </div>
  </t>
</templates>
