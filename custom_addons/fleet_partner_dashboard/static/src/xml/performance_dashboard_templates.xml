<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">
  <t t-name="owl.OwlPerformanceDashboard" owl="1">
     <div t-key="'owl_performance_dashboard_root'"
         class="o_fleet_dashboard p-4"
         style="height: 85vh; overflow-y: auto;">
      <t t-if="state.loading">
        <div>Loading…</div>
      </t>
      <t t-else="">
        <h1 class="mb-4">Performance Dashboard</h1>

        <!-- FILTER BAR -->
        <div class="mb-4 p-3 bg-light rounded d-flex gap-2">
          <!-- Anda Product -->
          <div class="dropdown" t-att-class="{'show': state.showProducts}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showProducts')">
              Anda Product
              <t t-if="state.selectedProducts.length">
                (<t t-esc="state.selectedProducts.length"/>)
              </t>
            </button>
            <div class="dropdown-menu"
                 t-att-class="{'show': state.showProducts}"
                 style="max-height:200px; overflow:auto;">
              <t t-foreach="state.productTypes" t-as="pt" t-key="pt.id">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedProducts.includes(pt.id)}"
                        t-on-click="() => toggleFilter('selectedProducts', pt.id)">
                  <t t-esc="pt.name"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Quality -->
          <div class="dropdown" t-att-class="{'show': state.showScores}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showScores')">
              Driver Quality
              <t t-if="state.selectedScores.length">
                (<t t-esc="state.selectedScores.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showScores}">
              <t t-foreach="state.qualityScores" t-as="sc" t-key="sc.key">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedScores.includes(sc.key)}"
                        t-on-click="() => toggleFilter('selectedScores', sc.key)">
                  <t t-esc="sc.label"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Driver Category -->
          <div class="dropdown" t-att-class="{'show': state.showCategories}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showCategories')">
              Driver Category
              <t t-if="state.selectedCategories.length">
                (<t t-esc="state.selectedCategories.length"/>)
              </t>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showCategories}">
              <t t-foreach="state.categories" t-as="ct" t-key="ct">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedCategories.includes(ct)}"
                        t-on-click="() => toggleFilter('selectedCategories', ct)">
                  <t t-esc="ct"/>
                </button>
              </t>
            </div>
          </div>

          <!-- Time Period -->
          <div class="dropdown" t-att-class="{'show': state.showPeriod}">
            <button class="btn btn-primary dropdown-toggle"
                    type="button"
                    t-on-click="() => toggleDropdown('showPeriod')">
              <t t-esc="state.selectedPeriod"/>
            </button>
            <div class="dropdown-menu" t-att-class="{'show': state.showPeriod}">
              <t t-foreach="state.timePeriods" t-as="pw" t-key="pw">
                <button class="dropdown-item"
                        t-att-class="{'active': state.selectedPeriod === pw}"
                        t-on-click="() => changePeriod(pw)">
                  <t t-esc="pw"/>
                </button>
              </t>
            </div>
          </div>
        </div>

        <!-- KPI CARDS -->
        <div class="row mb-4">
          <t t-foreach="Object.values(state.data)" t-as="drv" t-key="drv.id">
            <div class="col-md-4 mb-3">
              <div class="card h-100">
                <div class="card-body">
                  <h5 class="card-title"><t t-esc="drv.name"/></h5>
                  <p class="card-text mb-1">Trips: <t t-esc="drv.trips"/></p>
                  <p class="card-text mb-1">Hours: <t t-esc="drv.hours.toFixed(1)"/>h</p>
                  <p class="card-text mb-0">Revenue: <t t-esc="drv.cash"/></p>
                </div>
              </div>
            </div>
          </t>
        </div>

        <!-- Search box -->
        <div class="form-group mb-3">
          <input type="text"
                 class="form-control"
                 placeholder="Search driver..."
                 t-model="state.search"/>
        </div>

        <!-- DETAIL TABLE: -->
          <table class="table table-striped table-hover mb-0">
            <thead class="table-light">
              <tr>
                <th>Driver</th>
                <th>Phone</th>
                <th>Start Date</th>
                <th>Anda Product</th>
                <th>Category</th>
                <th>Active?</th>
                <th>Cash</th>
                <th>Trips</th>
                <th>Hours</th>
                <th>Accept. %</th>
                <th>Trips/hr</th>
                <th>Money/hr</th>
                <th>Efficiency %</th>
                <th>Svc Fee</th>
                <th>Partner Fee</th>
              </tr>
            </thead>
            <tbody>
              <t t-foreach="
                  Object.values(state.data)
                        .filter(d => d.name.toLowerCase()
                                      .includes(state.search.toLowerCase()))
                "
                t-as="d"
                t-key="d.id">
                <tr>
                  <td><t t-esc="d.name"/></td>
                  <td><t t-esc="d.phone"/></td>
                  <td><t t-esc="d.hire_date"/></td>
                  <td><t t-esc="d.product_type"/></td>
                  <td><t t-esc="d.type"/></td>
                  <td><t t-esc="d.active ? 'Yes' : 'No'"/></td>
                  <td><t t-esc="d.cash"/></td>
                  <td><t t-esc="d.trips"/></td>
                  <td><t t-esc="d.hours.toFixed(1)"/></td>
                  <td><t t-esc="d.acceptance_rate.toFixed(1)"/>%</td>
                  <td><t t-esc="d.trips_per_hour.toFixed(2)"/></td>
                  <td><t t-esc="d.money_per_hour.toFixed(2)"/></td>
                  <td><t t-esc="d.efficiency.toFixed(1)"/>%</td>
                  <td><t t-esc="d.service_fee.toFixed(2)"/></td>
                  <td><t t-esc="d.partner_fee.toFixed(2)"/></td>
                </tr>
              </t>
            </tbody>
          </table>

      </t>
    </div>
  </t>
</templates>
