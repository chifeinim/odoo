                    <t t-set="prev"  t-value="state.metrics.prevAvgUtilisation"/>
                    <t t-set="curr"  t-value="state.metrics.avgUtilisation"/>
                    <t t-set="delta" t-value="prev ? ((curr - prev)/prev*100) : 0"/>
                    <t t-if="delta >= 0">
