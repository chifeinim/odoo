<odoo>
  <!-- Tree view -->
  <record id="view_x_fleet_issue_tree" model="ir.ui.view">
    <field name="name">x_fleet_issue.tree</field>
    <field name="model">x_fleet_issue</field>
    <field name="arch" type="xml">
      <tree string="Issues"
            decoration-danger="color==2"
            decoration-warning="color==1"
            decoration-success="color==3">
        <field name="color" invisible="1"/>
        <field name="name"/>
        <field name="date_reported"/>
        <field name="driver_id"/>
        <field name="main_category"/>
        <field name="sub_category"/>
        <field name="sub_sub_category"/>
        <field name="status"/>
        <field name="can_work_label" readonly="1"/>
      </tree>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_x_fleet_issue_form" model="ir.ui.view">
    <field name="name">x_fleet_issue.form</field>
    <field name="model">x_fleet_issue</field>
    <field name="arch" type="xml">
      <form string="Issue">
        <sheet>
          <group>
            <field name="name" readonly="1"/>
            <field name="date_reported" readonly="1"/>
            <field name="driver_id"/>
          </group>
          <group string="Classification">
            <field name="main_category"/>
            <field name="sub_category"/>
            <field name="sub_sub_category"/>
          </group>
          <group>
            <field name="status"/>
            <field name="can_work" widget="boolean_toggle" string="Can Work"/>
          </group>
        </sheet>
        <div class="oe_chatter">
          <field name="message_follower_ids" widget="mail_followers"/>
          <field name="activity_ids" widget="mail_activity"/>
          <field name="message_ids" widget="mail_thread"/>
        </div>
      </form>
    </field>
  </record>

  <!-- Search view -->
  <record id="view_x_fleet_issue_search" model="ir.ui.view">
    <field name="name">x_fleet_issue.search</field>
    <field name="model">x_fleet_issue</field>
    <field name="arch" type="xml">
      <search string="Search Issues">

        <!-- Search Fields -->
        <field name="name" string="Issue ID"/>
        <field name="driver_id"/>
        <field name="main_category"/>
        <field name="sub_category"/>
        <field name="sub_sub_category"/>

        <!-- Filters -->
        <filter name="unresolved" string="Unresolved" domain="[('status','=','unresolved')]"/>
        <filter name="can_work_true" string="Can Work" domain="[('can_work','=',True)]"/>
        <filter name="can_work_false" string="Cannot Work" domain="[('can_work','=',False)]"/>

        <!-- Group By -->
        <separator/>
        <group expand="0" string="Group By">
          <filter string="Driver" name="grp_driver" context="{'group_by':'driver_id'}"/>
          <filter string="Main Category" name="grp_maincat" context="{'group_by':'main_category'}"/>
          <filter string="Date" name="grp_date" context="{'group_by':'date_reported'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action -->
  <record id="action_x_fleet_issue" model="ir.actions.act_window">
    <field name="name">Issues</field>
    <field name="res_model">x_fleet_issue</field>
    <field name="view_mode">tree,form</field>
  </record>
</odoo>
