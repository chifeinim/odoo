<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Tree View -->
    <record id="view_fleet_driver_tree" model="ir.ui.view">
      <field name="name">x.fleet.driver.tree</field>
      <field name="model">x_fleet_driver</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="phone"/>
          <field name="yango_driver_id"/>
          <field name="hire_date"/>
          <field name="work_status"/>
          <field name="type"/>
          <field name="product_type_id"/>
        </tree>
      </field>
    </record>

    <!-- Form View -->
    <record id="view_fleet_driver_form" model="ir.ui.view">
      <field name="name">x.fleet.driver.form</field>
      <field name="model">x_fleet_driver</field>
      <field name="arch" type="xml">
        <form string="Fleet Driver">
          <sheet>
            <group>
              <field name="name"/>
              <field name="phone"/>
              <field name="yango_driver_id"/>
              <field name="hire_date"/>
            </group>
            <group>
              <field name="work_status"/>
              <field name="type"/>
              <field name="product_type_id"/>
            </group>
            <notebook>
              <page string="Issues">
                <field name="issue_ids">
                  <tree editable="bottom">
                    <field name="name"/>
                    <field name="status"/>
                    <field name="date_reported"/>
                  </tree>
                </field>
              </page>
              <page string="Orders">
                <field name="order_ids">
                  <tree editable="bottom">
                    <field name="name"/>
                    <field name="order_date"/>
                    <field name="status"/>
                    <field name="price"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_driver" model="ir.actions.act_window">
      <field name="name">Fleet Drivers</field>
      <field name="res_model">x_fleet_driver</field>
      <field name="view_mode">tree,form</field>
    </record>
  </data>
</odoo>
