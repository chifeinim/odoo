<odoo>
  <!-- Root Menu -->
  <menuitem id="menu_fleet_dashboard_root"
            name="Fleet Dashboard"
            action="action_performance_dashboard"
            sequence="10"/>

  <!-- Drivers -->
  <menuitem id="menu_fleet_driver"
            name="Drivers"
            parent="menu_fleet_dashboard_root"
            action="action_fleet_driver"
            sequence="11"/>

  <!-- Cars -->
  <menuitem id="menu_fleet_car"
            name="Cars"
            parent="menu_fleet_dashboard_root"
            action="action_fleet_car"
            sequence="12"/>

  <!-- Product Types -->
  <menuitem id="menu_fleet_product_type"
            name="Product Types"
            parent="menu_fleet_dashboard_root"
            action="action_fleet_product_type"
            sequence="13"/>

  <!-- Orders -->
  <menuitem id="menu_fleet_order"
            name="Orders"
            parent="menu_fleet_dashboard_root"
            action="action_fleet_order"
            sequence="14"/>

  <!-- Supply Hours -->
  <menuitem id="menu_driver_supply_hours"
            name="Supply Hours"
            parent="menu_fleet_dashboard_root"
            action="action_driver_supply_hours"
            sequence="15"/>

  <!-- Issues -->
  <menuitem id="menu_fleet_issue"
            name="Issues"
            parent="menu_fleet_dashboard_root"
            action="action_x_fleet_issue"
            sequence="16"/>

  <!-- Parent “Technical” under Fleet Dashboard root -->
  <menuitem id="menu_fleet_technical"
            name="Technical"
            parent="fleet_partner_dashboard.menu_fleet_dashboard_root"
            sequence="99"/>

  <!-- Child “Queued Records” -->
  <menuitem id="menu_fleet_sync_queue"
            name="Queued Records"
            parent="menu_fleet_technical"
            action="action_fleet_sync_queue"
            sequence="10"/>

  <!-- Dashboards -->
  <record id="action_fleet_dashboard_webpage" model="ir.actions.act_url">
    <field name="name">Fleet Dashboard</field>
    <field name="url">/fleet_partner_dashboard</field>
    <field name="target">self</field>
  </record>
  <menuitem id="menu_fleet_dashboard_page"
            name="Dashboards"
            parent="menu_fleet_dashboard_root"
            sequence="1"
            action="action_fleet_dashboard_webpage"/>
  <menuitem id="menu_fleet_driver_dashboard"
            name="Support Dashboard"
            parent="menu_fleet_dashboard_page"
            sequence="10"
            action="action_owl_driver_dashboard"/>
  <menuitem id="menu_performance_dashboard"
            name="Performance Dashboard"
            parent="menu_fleet_dashboard_page"
            sequence="20"
            action="action_performance_dashboard"/>
  <menuitem id="menu_low_performers_dashboard"
            name="Low Performers"
            parent="menu_fleet_dashboard_page"
            sequence="30"
            action="action_low_performers_dashboard"/>

  <!-- Call Center parent (reusing old Call Notes menu id) -->
  <menuitem id="menu_x_fleet_call_note"
            name="Call Center"
            parent="fleet_partner_dashboard.menu_fleet_dashboard_root"
            sequence="2"/>

  <!-- Call Center children -->

  <!-- Placeholder for future Call Center Workflow dashboard.
       No action yet; you can attach an act_url or act_window later. -->
  <menuitem id="menu_call_center_workflow"
            name="Call Center Workflow"
            parent="menu_x_fleet_call_note"
            action="action_call_center_dashboard"
            sequence="10"/>

  <!-- Issue Rules -->
  <menuitem id="menu_x_fleet_performance_issue_rule"
            name="Issue Rules"
            parent="menu_x_fleet_call_note"
            action="action_x_fleet_performance_issue_rule"
            sequence="20"/>

  <!-- Rule Exceptions per Product -->
  <menuitem id="menu_x_fleet_performance_issue_exception"
            name="Rule Exceptions"
            parent="menu_x_fleet_call_note"
            action="action_x_fleet_performance_issue_exception"
            sequence="30"/>

  <!-- Issue Call Notes list -->
  <menuitem id="menu_x_fleet_call_note_list"
            name="Issue Call Notes"
            parent="menu_x_fleet_call_note"
            action="action_x_fleet_issue_call_note"
            sequence="40"/>

</odoo>
