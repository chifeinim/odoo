<odoo>
<!-- Root Menu -->
    <menuitem id="menu_fleet_dashboard_root"
          name="Fleet Dashboard"
          action="action_fleet_driver"
          sequence="10"/>

    <!-- Drivers Menu -->
    <menuitem id="menu_fleet_driver" name="Drivers"
              parent="menu_fleet_dashboard_root"
              action="action_fleet_driver"/>

    <!-- Orders Menu -->
    <menuitem id="menu_fleet_order" name="Orders"
              parent="menu_fleet_dashboard_root"
              action="action_fleet_order"/>

    <!-- Supply Hours -->
    <menuitem id="menu_driver_supply_hours"
              name="Supply Hours"
              parent="menu_fleet_dashboard_root"
              action="action_driver_supply_hours"
              sequence="17"/>

    <!-- Product Types Menu -->
    <menuitem id="menu_fleet_product_type" name="Product Types"
              parent="menu_fleet_dashboard_root"
              action="action_fleet_product_type"/>

    <!-- Driver Issues (parent tab, no action) -->
    <menuitem id="menu_fleet_driver_issue"
              name="Driver Issues"
              parent="menu_fleet_dashboard_root"
              sequence="30"/> <!-- No action here -->

    <!-- Issues (child of Driver Issues) -->
    <menuitem id="menu_fleet_driver_issue_issues"
              name="Issues"
              parent="menu_fleet_driver_issue"
              action="action_fleet_driver_issue"
              sequence="10"/>

    <!-- Issue Tags (child of Driver Issues) -->
    <menuitem id="menu_fleet_driver_issue_tags"
              name="Issue Tags"
              parent="menu_fleet_driver_issue"
              action="action_driver_issue_tags"
              sequence="20"/>

    <!-- Action to open OWL page -->
    <record id="action_fleet_dashboard_webpage" model="ir.actions.act_url">
        <field name="name">Fleet Dashboard</field>
        <field name="url">/fleet_partner_dashboard</field>
        <field name="target">self</field>
    </record>

    <!-- Dashboard Menu (Parent already exists) -->
    <menuitem id="menu_fleet_dashboard_page"
              name="Dashboards"
              parent="menu_fleet_dashboard_root"
              sequence="1"
              action="action_fleet_dashboard_webpage"/>

    <menuitem id="menu_fleet_driver_dashboard"
          name="Support Dashboard"
          parent="menu_fleet_dashboard_page"
          sequence="10"
          action="action_owl_driver_dashboard"/>

</odoo>
