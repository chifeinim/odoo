<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <record id="view_fleet_car_tree" model="ir.ui.view">
      <field name="name">x.fleet.car.tree</field>
      <field name="model">x_fleet_car</field>
      <field name="arch" type="xml">
        <tree>
          <field name="name"/>
          <field name="car_id"/>
          <field name="brand"/>
          <field name="model"/>
          <field name="color"/>
          <field name="year"/>
          <field name="status"/>
        </tree>
      </field>
    </record>

    <record id="view_fleet_car_form" model="ir.ui.view">
      <field name="name">x.fleet.car.form</field>
      <field name="model">x_fleet_car</field>
      <field name="arch" type="xml">
        <form string="Fleet Car">
          <sheet>
            <group>
              <field name="name"/>
              <field name="car_id"/>
              <field name="brand"/>
              <field name="model"/>
            </group>
            <group>
              <field name="color"/>
              <field name="year"/>
              <field name="vin"/>
              <field name="status"/>
            </group>
            <notebook>
              <page string="Drivers">
                <field name="driver_ids">
                  <tree>
                    <field name="name"/>
                    <field name="phone"/>
                    <field name="yango_driver_id"/>
                    <field name="work_status"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_fleet_car" model="ir.actions.act_window">
      <field name="name">Fleet Cars</field>
      <field name="res_model">x_fleet_car</field>
      <field name="view_mode">tree,form</field>
    </record>
  </data>
</odoo>
