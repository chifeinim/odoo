<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_fleet_driver_issue_tree" model="ir.ui.view">
        <field name="name">x.fleet.driver.issue.tree</field>
        <field name="model">x_fleet_driver_issue</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="driver_id"/>
                <field name="date_reported"/>
                <field name="status"/>
                <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_fleet_driver_issue_form" model="ir.ui.view">
        <field name="name">x.fleet.driver.issue.form</field>
        <field name="model">x_fleet_driver_issue</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="driver_id"/>
                        <field name="status"/>
                        <field name="date_reported"/>
                        <field name="tag_ids" widget="many2many_tags" options="{'color_field': 'color'}"/>
                        <field name="description"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Search View -->
    <record id="view_fleet_driver_issue_search" model="ir.ui.view">
        <field name="name">x.fleet.driver.issue.search</field>
        <field name="model">x_fleet_driver_issue</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="status"/>
                <field name="driver_id"/>
                <field name="tag_ids"/>
                <field name="date_reported"/>
            </search>
        </field>
    </record>

    <!-- Action -->
    <record id="action_fleet_driver_issue" model="ir.actions.act_window">
        <field name="name">Driver Issues</field>
        <field name="res_model">x_fleet_driver_issue</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first driver issue
            </p>
        </field>
    </record>

</odoo>
