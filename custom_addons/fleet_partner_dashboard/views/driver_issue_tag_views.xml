<?xml version="1.0" encoding="UTF-8"?>
<odoo>
    <!-- Tree View -->
    <record id="view_driver_issue_tag_tree" model="ir.ui.view">
        <field name="name">x.fleet.driver.issue.tag.tree</field>
        <field name="model">x_fleet_driver_issue_tag</field>
        <field name="arch" type="xml">
            <tree>
                <field name="name"/>
                <field name="color" widget="color_picker"/>
            </tree>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_driver_issue_tag_form" model="ir.ui.view">
        <field name="name">x.fleet.driver.issue.tag.form</field>
        <field name="model">x_fleet_driver_issue_tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="color" widget="color_picker"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Action -->
    <record id="action_driver_issue_tags" model="ir.actions.act_window">
        <field name="name">Issue Tags</field>
        <field name="res_model">x_fleet_driver_issue_tag</field>
        <field name="view_mode">tree,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create tags to classify driver issues
            </p>
        </field>
    </record>

</odoo>
