<odoo>
  <record id="view_x_fleet_incident_subcategory_tree" model="ir.ui.view">
    <field name="name">x_fleet_incident_subcategory.tree</field>
    <field name="model">x_fleet_incident_subcategory</field>
    <field name="arch" type="xml">
      <tree string="Sub‑Categories">
        <field name="name"/>
        <field name="category_id"/>
      </tree>
    </field>
  </record>

  <record id="view_x_fleet_incident_subcategory_form" model="ir.ui.view">
    <field name="name">x_fleet_incident_subcategory.form</field>
    <field name="model">x_fleet_incident_subcategory</field>
    <field name="arch" type="xml">
      <form string="Sub‑Category">
        <sheet>
          <group>
            <field name="category_id"/>
            <field name="name"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <record id="action_x_fleet_incident_subcategory" model="ir.actions.act_window">
    <field name="name">Sub‑Categories</field>
    <field name="res_model">x_fleet_incident_subcategory</field>
    <field name="view_mode">tree,form</field>
    <field name="help" type="html">
      <p class="oe_view_nocontent_create">
        Create your first sub‑category
      </p>
    </field>
  </record>
</odoo>
