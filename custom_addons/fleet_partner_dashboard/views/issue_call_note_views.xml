<?xml version="1.0" encoding="UTF-8"?>
<odoo>

  <!-- Tree view -->
  <record id="view_x_fleet_issue_call_note_tree" model="ir.ui.view">
    <field name="name">x_fleet_issue_call_note.tree</field>
    <field name="model">x_fleet_issue_call_note</field>
    <field name="arch" type="xml">
      <tree string="Issue Call Notes" create="false">
        <field name="created_at"/>
        <field name="issue_id"/>
        <field name="driver_id"/>
        <field name="status_from"/>
        <field name="status_to"/>
        <field name="author_id"/>
        <field name="note"/>
      </tree>
    </field>
  </record>

  <!-- Form view -->
  <record id="view_x_fleet_issue_call_note_form" model="ir.ui.view">
    <field name="name">x_fleet_issue_call_note.form</field>
    <field name="model">x_fleet_issue_call_note</field>
    <field name="arch" type="xml">
      <form string="Issue Call Note">
        <sheet>
          <group>
            <group>
              <field name="issue_id" readonly="1"/>
              <field name="driver_id" readonly="1"/>
            </group>
            <group>
              <field name="created_at" readonly="1"/>
              <field name="author_id" readonly="1"/>
            </group>
          </group>

          <group string="Status Change">
            <group>
              <field name="status_from" readonly="1"/>
              <field name="status_to" readonly="1"/>
            </group>
          </group>

          <group string="Call Note">
            <field name="note" readonly="1"/>
          </group>
        </sheet>
      </form>
    </field>
  </record>

  <!-- Search view -->
  <record id="view_x_fleet_issue_call_note_search" model="ir.ui.view">
    <field name="name">x_fleet_issue_call_note.search</field>
    <field name="model">x_fleet_issue_call_note</field>
    <field name="arch" type="xml">
      <search string="Issue Call Notes">
        <field name="issue_id"/>
        <field name="driver_id"/>
        <field name="author_id"/>
        <field name="status_from"/>
        <field name="status_to"/>
        <field name="note"/>

        <filter name="status_changed"
                string="Status Changed"
                domain="['|', ('status_from', '!=', False), ('status_to', '!=', False)]"/>

        <group expand="0" string="Group By">
          <filter name="group_issue" string="Issue" context="{'group_by': 'issue_id'}"/>
          <filter name="group_driver" string="Driver" context="{'group_by': 'driver_id'}"/>
          <filter name="group_author" string="Author" context="{'group_by': 'author_id'}"/>
          <filter name="group_created" string="Created Date" context="{'group_by': 'created_at'}"/>
        </group>
      </search>
    </field>
  </record>

  <!-- Action for Issue Call Notes -->
  <record id="action_x_fleet_issue_call_note" model="ir.actions.act_window">
    <field name="name">Issue Call Notes</field>
    <field name="res_model">x_fleet_issue_call_note</field>
    <field name="view_mode">tree,form</field>
    <field name="view_id" ref="view_x_fleet_issue_call_note_tree"/>
    <field name="search_view_id" ref="view_x_fleet_issue_call_note_search"/>
    <field name="help" type="html">
      <p>
        This list shows call notes captured when issue statuses are updated
        in the Call Center workflow.
      </p>
    </field>
  </record>

</odoo>
