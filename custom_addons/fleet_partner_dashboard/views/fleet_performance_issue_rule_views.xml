<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>

    <!-- ===================== x_fleet_performance_issue_rule ===================== -->

    <!-- Tree view -->
    <record id="view_x_fleet_performance_issue_rule_tree" model="ir.ui.view">
      <field name="name">x.fleet.performance.issue.rule.tree</field>
      <field name="model">x_fleet_performance_issue_rule</field>
      <field name="arch" type="xml">
        <tree string="Performance Issue Rules">
          <field name="name"/>
          <field name="code"/>
          <field name="enabled"/>
          <field name="min_days_since_hire"/>
          <field name="churn_inactive_days"/>
          <field name="active_hours_threshold"/>
          <field name="active_trips_threshold"/>
        </tree>
      </field>
    </record>

    <!-- Form view -->
    <record id="view_x_fleet_performance_issue_rule_form" model="ir.ui.view">
      <field name="name">x.fleet.performance.issue.rule.form</field>
      <field name="model">x_fleet_performance_issue_rule</field>
      <field name="arch" type="xml">
        <form string="Performance Issue Rule">
          <sheet>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="enabled"/>
            </group>

            <notebook>
              <page string="Default Rules">
                <group>
                  <group>
                    <field name="min_days_since_hire"/>
                    <field name="churn_inactive_days"/>
                  </group>
                  <group>
                    <field name="active_hours_threshold"/>
                    <field name="active_trips_threshold"/>
                  </group>
                </group>
              </page>

              <page string="Per Product Types">
                <field name="product_line_ids">
                  <tree editable="bottom" string="Exceptions per Product">
                    <field name="product_type_id"/>
                    <field name="enabled"/>
                    <field name="work_rule_external_id" readonly="1"/>
                    <field name="min_days_since_hire"/>
                    <field name="churn_inactive_days"/>
                    <field name="active_hours_threshold"/>
                    <field name="active_trips_threshold"/>
                  </tree>
                </field>
              </page>
            </notebook>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action -->
    <record id="action_x_fleet_performance_issue_rule" model="ir.actions.act_window">
      <field name="name">Issue Rules</field>
      <field name="res_model">x_fleet_performance_issue_rule</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Create rules (New / Active / Churn) and their default thresholds.
        </p>
      </field>
    </record>

    <!-- ===================== x_fleet_performance_issue_exception ===================== -->

    <!-- Tree view -->
    <record id="view_x_fleet_performance_issue_exception_tree" model="ir.ui.view">
      <field name="name">x.fleet.performance.issue.exception.tree</field>
      <field name="model">x_fleet_performance_issue_exception</field>
      <field name="arch" type="xml">
        <tree string="Performance Issue Exceptions per Product">
          <field name="rule_id"/>
          <field name="product_type_id"/>
          <field name="enabled"/>
          <field name="work_rule_external_id" readonly="1"/>
          <field name="min_days_since_hire"/>
          <field name="churn_inactive_days"/>
          <field name="active_hours_threshold"/>
          <field name="active_trips_threshold"/>
        </tree>
      </field>
    </record>

    <!-- Form view -->
    <record id="view_x_fleet_performance_issue_exception_form" model="ir.ui.view">
      <field name="name">x.fleet.performance.issue.exception.form</field>
      <field name="model">x_fleet_performance_issue_exception</field>
      <field name="arch" type="xml">
        <form string="Performance Issue Exception">
          <sheet>
            <group>
              <field name="rule_id"/>
              <field name="product_type_id"/>
              <field name="enabled"/>
            </group>

            <group string="Overrides">
              <group>
                <field name="min_days_since_hire"/>
                <field name="churn_inactive_days"/>
              </group>
              <group>
                <field name="active_hours_threshold"/>
                <field name="active_trips_threshold"/>
                <field name="work_rule_external_id" readonly="1"/>
              </group>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action -->
    <record id="action_x_fleet_performance_issue_exception" model="ir.actions.act_window">
      <field name="name">Rule Exceptions</field>
      <field name="res_model">x_fleet_performance_issue_exception</field>
      <field name="view_mode">tree,form</field>
      <field name="help" type="html">
        <p class="o_view_nocontent_smiling_face">
          Configure which rules apply to which product types, and override defaults.
        </p>
      </field>
    </record>

  </data>
</odoo>
