<?xml version="1.0" encoding="UTF-8"?>
<odoo>
  <data>
    <!-- Tree -->
    <record id="view_x_fleet_call_note_tree" model="ir.ui.view">
      <field name="name">x.fleet.call.note.tree</field>
      <field name="model">x_fleet_call_note</field>
      <field name="arch" type="xml">
        <tree>
          <field name="created_at"/>
          <field name="driver_id"/>
          <field name="author_id"/>
          <field name="note"/>
        </tree>
      </field>
    </record>

    <!-- Form -->
    <record id="view_x_fleet_call_note_form" model="ir.ui.view">
      <field name="name">x.fleet.call.note.form</field>
      <field name="model">x_fleet_call_note</field>
      <field name="arch" type="xml">
        <form string="Driver Call Note">
          <sheet>
            <group>
              <field name="driver_id" options="{'no_open': True}"/>
              <field name="created_at" readonly="1"/>
              <field name="author_id" readonly="1"/>
            </group>
            <group>
              <field name="note" placeholder="Enter call note..." nolabel="1"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <!-- Action + Menu (so you can access outside dashboard) -->
    <record id="action_x_fleet_call_note" model="ir.actions.act_window">
      <field name="name">Call Notes</field>
      <field name="res_model">x_fleet_call_note</field>
      <field name="view_mode">tree,form</field>
    </record>

  </data>
</odoo>
